    <Compile Include="..\LagCheck.WinUI\ShellNavigation.cs" Link="ShellNavigation.cs" />
    <Compile Include="..\LagCheck.WinUI\NavigationRoute.cs" Link="NavigationRoute.cs" />
    <Compile Include="..\LagCheck.WinUI\Library\AsyncCommand.cs" Link="Library\AsyncCommand.cs" />
    <Compile Include="..\LagCheck.WinUI\Library\LibraryContracts.cs" Link="Library\LibraryContracts.cs" />
    <Compile Include="..\LagCheck.WinUI\Library\LibraryViewModel.cs" Link="Library\LibraryViewModel.cs" />
    <Compile Include="..\LagCheck.WinUI\Library\LibraryWireParser.cs" Link="Library\LibraryWireParser.cs" />
  </ItemGroup>
</Project>
