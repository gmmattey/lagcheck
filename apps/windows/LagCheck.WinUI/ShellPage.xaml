<Page x:Class="LagCheck.WinUI.ShellPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ctl="using:LagCheck.WinUI.Controls"
      xmlns:automation="using:Microsoft.UI.Xaml.Automation">
  <Grid x:Name="RootGrid" Background="{StaticResource DeepBrush}">

    <!-- Papel de parede persistente (estilo PlayStation 5) -->
    <Grid x:Name="WallpaperHost" IsHitTestVisible="False">
      <Image x:Name="WallpaperImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <!-- Véu escuro vertical: #4D070914 (topo) a #A6070914 (base) -->
      <Rectangle>
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4D070914" Offset="0"/>
            <GradientStop Color="#A6070914" Offset="1"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <!-- Véu escuro horizontal leve: mais escuro à esquerda (#4D070914 -> #00070914) -->
      <Rectangle>
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4D070914" Offset="0"/>
            <GradientStop Color="#00070914" Offset="1"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
    </Grid>

    <!-- Camada de arte atrás de toda a janela (Início e resultado de um jogo): cobre também a sidebar, como no v2 -->
    <Grid x:Name="BackdropHost" Visibility="Collapsed" Opacity="0" Background="{StaticResource DeepBrush}" IsHitTestVisible="False">
      <Grid x:Name="BackdropSlides" HorizontalAlignment="Left">
        <Grid.RenderTransform>
          <CompositeTransform x:Name="BackdropShift"/>
        </Grid.RenderTransform>
      </Grid>
      <Grid x:Name="BackdropTransition" Opacity="0" IsHitTestVisible="False"/>
      <Rectangle x:Name="BackdropVeil" Visibility="Collapsed">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E60B0D10" Offset="0"/>
            <GradientStop Color="#F50B0D10" Offset="1"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
    </Grid>

    <!-- O conteúdo ocupa toda a largura; sem barra lateral. A seta de voltar e os atalhos do topo da Início cuidam da navegação. -->
    <Frame x:Name="ContentFrame" Background="Transparent" Margin="0,56,0,0"/>

    <!-- Região arrastável da barra de título (os botões nativos ficam por cima, à direita) -->
    <Border x:Name="DragRegion" VerticalAlignment="Top" Height="32" Background="Transparent" Margin="100,0,0,0"/>

    <Button x:Name="TopHomeButton" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="48,6,0,0"
            Width="44" Height="44" Padding="0" CornerRadius="22"
            Style="{StaticResource CircleIconButtonStyle}" Click="TopNavigation_Click" automation:AutomationProperties.Name="Voltar">
      <Grid>
        <Image x:Name="TopBrandIcon" Source="ms-appx:///Assets/lagcheck-mark.svg" Width="24" Height="24"/>
        <ctl:SvgIcon x:Name="TopBackIcon" Data="M15 6l-6 6 6 6" Size="18" StrokeWidth="2.5" Foreground="{StaticResource TextPrimaryBrush}" Visibility="Collapsed"/>
      </Grid>
    </Button>

    <!-- Toast flutuante -->
    <Border x:Name="ToastBorder" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
            Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineStrongBrush}"
            BorderThickness="1" CornerRadius="12" Padding="18,12" Visibility="Collapsed" Opacity="0">
      <TextBlock x:Name="ToastText" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
    </Border>

  </Grid>
</Page>
