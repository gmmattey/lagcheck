<Page x:Class="LagCheck.WinUI.ShellPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ctl="using:LagCheck.WinUI.Controls"
      xmlns:automation="using:Microsoft.UI.Xaml.Automation">
  <Grid x:Name="RootGrid" Background="{StaticResource DeepBrush}">

    <!-- Camada de arte atrás de toda a janela (Início e resultado de um jogo): cobre também a sidebar, como no v2 -->
    <Grid x:Name="BackdropHost" Visibility="Collapsed" Background="#0B0D10" IsHitTestVisible="False">
      <Grid x:Name="BackdropSlides" HorizontalAlignment="Left">
        <Grid.RenderTransform>
          <CompositeTransform x:Name="BackdropShift"/>
        </Grid.RenderTransform>
      </Grid>
      <Rectangle x:Name="BackdropHeroSide">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#F00B0D12" Offset="0"/>
            <GradientStop Color="#9E0B0D12" Offset="0.42"/>
            <GradientStop Color="#1F0B0D12" Offset="1"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle x:Name="BackdropHeroDepth">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#800B0D12" Offset="0"/>
            <GradientStop Color="#000B0D12" Offset="0.22"/>
            <GradientStop Color="#000B0D12" Offset="0.5"/>
            <GradientStop Color="#EB0B0D12" Offset="1"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle x:Name="BackdropVeil" Visibility="Collapsed">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E60B0D10" Offset="0"/>
            <GradientStop Color="#F50B0D10" Offset="1"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
    </Grid>

    <!-- Palco: o Frame ocupa a janela à direita da faixa reservada da sidebar -->
    <Frame x:Name="ContentFrame" Margin="64,56,0,0"/>

    <!-- Região arrastável da barra de título (os botões nativos ficam por cima, à direita) -->
    <Border x:Name="DragRegion" VerticalAlignment="Top" Height="32" Background="Transparent" Margin="64,0,0,0"/>

    <!-- Toast flutuante -->
    <Border x:Name="ToastBorder" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,24"
            Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineStrongBrush}"
            BorderThickness="1" CornerRadius="12" Padding="18,12" Visibility="Collapsed">
      <TextBlock x:Name="ToastText" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
    </Border>

    <!-- Sombra projetada pela sidebar quando expande sobre o conteúdo -->
    <Rectangle x:Name="SidebarShadow" HorizontalAlignment="Left" Width="22" Margin="64,0,0,0" IsHitTestVisible="False">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#66000000" Offset="0"/>
          <GradientStop Color="#22000000" Offset="0.45"/>
          <GradientStop Color="#00000000" Offset="1"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <!-- Sidebar retrátil: ocupa 64px de layout e se expande SOBRE o conteúdo ao passar o mouse -->
    <Grid x:Name="Sidebar" HorizontalAlignment="Left" Width="64" Background="#0D0F14"
          BorderBrush="#14FFFFFF" BorderThickness="0,0,1,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Cabeçalho expandido -->
      <Grid x:Name="ExpandedHeader" Padding="16,16,12,12" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <Image Source="ms-appx:///Assets/wordmark-primary.svg" Height="30" HorizontalAlignment="Left" automation:AutomationProperties.Name="LagCheck"/>
        </StackPanel>
        <Button x:Name="SidebarCollapseButton" Grid.Column="1" Style="{StaticResource CircleIconButtonStyle}" Width="32" Height="32" CornerRadius="16"
                Background="#252A36" Click="SidebarToggle_Click" automation:AutomationProperties.Name="Recolher barra lateral">
          <ctl:SvgIcon Data="M15 6l-6 6 6 6" Size="11" StrokeWidth="2.5" Foreground="{StaticResource TextSecondaryBrush}"/>
        </Button>
      </Grid>

      <!-- Cabeçalho recolhido -->
      <StackPanel x:Name="CollapsedHeader" HorizontalAlignment="Center" Padding="0,16,0,12" Spacing="10">
        <Image Source="ms-appx:///Assets/lagcheck-mark.svg" Width="22" Height="16" HorizontalAlignment="Center" automation:AutomationProperties.Name="LagCheck"/>
        <Button x:Name="SidebarExpandButton" Style="{StaticResource CircleIconButtonStyle}" Width="34" Height="34" CornerRadius="17"
                Background="#252A36" Click="SidebarToggle_Click" automation:AutomationProperties.Name="Expandir barra lateral">
          <ctl:SvgIcon Data="M9 6l6 6-6 6" Size="11" StrokeWidth="2.5" Foreground="{StaticResource TextSecondaryBrush}"/>
        </Button>
      </StackPanel>

      <StackPanel x:Name="NavItemsPanel" Grid.Row="1" Padding="0,8,0,0" Spacing="4" HorizontalAlignment="Center" Width="64">
        <!-- Busca rápida -->
        <Button x:Name="QuickSearchButton" Style="{StaticResource SearchNavButtonStyle}" Click="QuickSearch_Click" Width="44" HorizontalAlignment="Center">
          <Grid Height="44">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="40"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ctl:SvgIcon Data="M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM21 21l-5-5" Size="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="SearchLabel" Grid.Column="1" Text="Buscar jogo..." Foreground="{StaticResource TextTertiaryBrush}" FontWeight="Normal" VerticalAlignment="Center" Margin="2,0,0,0" Visibility="Collapsed"/>
          </Grid>
        </Button>
        <Border x:Name="SearchSeparator" Height="1" Background="#0DFFFFFF" Margin="16,4" Visibility="Collapsed"/>

        <Button x:Name="HomeButton" Style="{StaticResource NavButtonStyle}" Click="Home_Click" Width="44" HorizontalAlignment="Center">
          <Grid Height="44">
            <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ctl:SvgIcon Data="M3 11l9-8 9 8v10h-6v-6H9v6H3z" Size="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="HomeLabel" Grid.Column="1" Text="Início" FontWeight="SemiBold" FontSize="14" Foreground="{Binding Foreground, ElementName=HomeButton}" VerticalAlignment="Center" Margin="2,0,0,0" Visibility="Collapsed"/>
          </Grid>
        </Button>

        <Button x:Name="LibraryButton" Style="{StaticResource NavButtonStyle}" Click="Library_Click" Width="44" HorizontalAlignment="Center">
          <Grid Height="44">
            <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ctl:SvgIcon Data="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z" Size="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="LibraryLabel" Grid.Column="1" Text="Biblioteca" FontWeight="SemiBold" FontSize="14" Foreground="{Binding Foreground, ElementName=LibraryButton}" VerticalAlignment="Center" Margin="2,0,0,0" Visibility="Collapsed"/>
          </Grid>
        </Button>

        <Button x:Name="GeneralCheckButton" Style="{StaticResource NavButtonStyle}" Click="GeneralCheck_Click" Width="44" HorizontalAlignment="Center">
          <Grid Height="44">
            <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ctl:SvgIcon Data="M4 20v-4M10 20v-8M16 20V8M22 20V4" Size="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="GeneralCheckLabel" Grid.Column="1" Text="Conexão" FontWeight="SemiBold" FontSize="14" Foreground="{Binding Foreground, ElementName=GeneralCheckButton}" VerticalAlignment="Center" Margin="2,0,0,0" Visibility="Collapsed"/>
          </Grid>
        </Button>

        <Button x:Name="HistoryButton" Style="{StaticResource NavButtonStyle}" Click="History_Click" Width="44" HorizontalAlignment="Center">
          <Grid Height="44">
            <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ctl:SvgIcon Data="M12 7v5l3 2M3 12a9 9 0 1 0 3-6.7M3 4v5h5" Size="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="HistoryLabel" Grid.Column="1" Text="Histórico" FontWeight="SemiBold" FontSize="14" Foreground="{Binding Foreground, ElementName=HistoryButton}" VerticalAlignment="Center" Margin="2,0,0,0" Visibility="Collapsed"/>
          </Grid>
        </Button>

        <Button x:Name="SettingsButton" Style="{StaticResource NavButtonStyle}" Click="Settings_Click" Width="44" HorizontalAlignment="Center">
          <Grid Height="44">
            <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ctl:SvgIcon Data="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2" Size="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="SettingsLabel" Grid.Column="1" Text="Ajustes" FontWeight="SemiBold" FontSize="14" Foreground="{Binding Foreground, ElementName=SettingsButton}" VerticalAlignment="Center" Margin="2,0,0,0" Visibility="Collapsed"/>
          </Grid>
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</Page>
