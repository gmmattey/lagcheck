<Page
    x:Class="LagCheck.WinUI.Library.LibraryPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LagCheck.WinUI.Library"
    xmlns:ctl="using:LagCheck.WinUI.Controls"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    Background="Transparent"
    Loaded="LibraryPage_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="22" Padding="40,32,40,56">

            <!-- Cabeçalho -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Bottom">
                    <TextBlock x:Name="LibraryTitle" Text="BIBLIOTECA" Style="{StaticResource DisplayTitleStyle}" FontSize="36" LineHeight="36" LineStackingStrategy="BlockLineHeight"/>
                    <TextBlock x:Name="CountText" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                </StackPanel>
                <Button x:Name="RescanButton" Grid.Column="1" Style="{StaticResource SecondaryCompactButtonStyle}"
                        Click="Rescan_Click" VerticalAlignment="Bottom" automation:AutomationProperties.Name="Procurar jogos">
                    <TextBlock x:Name="RescanButtonText" Text="Procurar jogos" FontSize="13" FontWeight="SemiBold"/>
                </Button>
            </Grid>

            <!-- Busca e ordenação -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" PlaceholderText="Buscar na sua biblioteca"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="46" CornerRadius="14" Padding="16,13,16,0" FontSize="14"/>
                <ComboBox x:Name="SortBox" Grid.Column="1" SelectionChanged="Sort_SelectionChanged" Height="46" MinWidth="230" CornerRadius="14" Padding="14,0" FontSize="14" SelectedIndex="0">
                    <ComboBoxItem x:Name="SortNameItem" Content="Ordenar: Nome A–Z" Tag="Name"/>
                    <ComboBoxItem x:Name="SortRecentItem" Content="Ordenar: Mais recentes" Tag="Recent"/>
                    <ComboBoxItem x:Name="SortPlatformItem" Content="Ordenar: Plataforma" Tag="Platform"/>
                    <ComboBoxItem x:Name="SortFavoritesItem" Content="Ordenar: Favoritos primeiro" Tag="Favorites"/>
                </ComboBox>
            </Grid>

            <!-- Filtros -->
            <ctl:WrapPanel x:Name="FilterChips" Spacing="8"/>

            <Border x:Name="EmptyResultsBorder" Background="{StaticResource SurfaceBrush}" CornerRadius="20" Padding="28" BorderBrush="#12FFFFFF" BorderThickness="1" Visibility="Collapsed">
                <TextBlock x:Name="EmptyResultsText" Text="Nenhum jogo corresponde à busca ou ao filtro atual." Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
            </Border>

            <!-- Grade 2:3 (minmax(180px,1fr), gap 20) -->
            <ItemsRepeater x:Name="GamesGrid" ItemsSource="{Binding VisibleGames}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="180" MinItemHeight="270" MinColumnSpacing="20" MinRowSpacing="20" ItemsStretch="Uniform"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:LibraryGame">
                        <Grid CornerRadius="18" IsTabStop="True" UseSystemFocusVisuals="True" automation:AutomationProperties.Name="{x:Bind Title}"
                              ToolTipService.ToolTip="{x:Bind Title}" Background="#171B24">
                            <ctl:StripedBackground Band="14"/>
                            <Image Source="{x:Bind local:CardBind.Cover(CoverArtworkPath)}" Stretch="UniformToFill"/>
                            <Grid VerticalAlignment="Bottom" Padding="14,30,14,12">
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#000D0F14" Offset="0"/>
                                        <GradientStop Color="#EB0D0F14" Offset="1"/>
                                    </LinearGradientBrush>
                                </Grid.Background>
                                <TextBlock Text="{x:Bind Title}" FontFamily="{StaticResource HeadingBoldFont}" FontWeight="Bold" FontSize="17" LineHeight="19.5" LineStackingStrategy="BlockLineHeight"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <Border Background="#B80D0F14" CornerRadius="15" Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"
                                    ToolTipService.ToolTip="{x:Bind PlatformLabel}">
                                <Grid>
                                    <ctl:SvgIcon Data="{x:Bind local:CardBind.Logo(Platform)}" FillOnly="True" Size="15" Foreground="{StaticResource TextPrimaryBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind local:CardBind.HasLogo(Platform)}"/>
                                    <ctl:SvgIcon Data="M5 4h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM8 20h8M12 16v4" Size="15" Foreground="{StaticResource TextPrimaryBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind local:CardBind.NoLogo(Platform)}"/>
                                </Grid>
                            </Border>
                            <Border Background="#B30D0F14" CornerRadius="14" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                                    Visibility="{x:Bind local:CardBind.Show(IsFavorite)}">
                                <ctl:SvgIcon Data="M12 21s-7-4.6-9.3-9A5.3 5.3 0 0 1 12 6.6 5.3 5.3 0 0 1 21.3 12C19 16.4 12 21 12 21z" IsFilled="True" Size="14" Foreground="{StaticResource CoralBrush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border CornerRadius="18" BorderThickness="1" BorderBrush="#14FFFFFF" IsHitTestVisible="False"/>
                            <Border CornerRadius="18" BorderThickness="2" BorderBrush="#B3A78BFA" Opacity="0" IsHitTestVisible="False"/>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
