<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Paleta Dark Competitive UI Refinada (Superfícies sólidas e anti-aliasing suave) -->
  <Color x:Key="StageColor">#0D0F14</Color>
  <Color x:Key="DeepColor">#11141B</Color>
  <Color x:Key="SurfaceColor">#171B24</Color>
  <Color x:Key="PanelColor">#202633</Color>
  <Color x:Key="LineColor">#0DFFFFFF</Color>
  <Color x:Key="LineStrongColor">#1AFFFFFF</Color>
  <Color x:Key="TextPrimaryColor">#F5F7FC</Color>
  <Color x:Key="TextSecondaryColor">#9AA3B5</Color>
  <Color x:Key="TextTertiaryColor">#687285</Color>
  <Color x:Key="PurpleColor">#7C3AED</Color>
  <Color x:Key="PurpleLightColor">#A78BFA</Color>
  <Color x:Key="ReadyColor">#22C55E</Color>
  <Color x:Key="CautionColor">#F59E0B</Color>
  <Color x:Key="CoralColor">#FF5A36</Color>

  <!-- Pincéis / Brushes -->
  <SolidColorBrush x:Key="StageBrush" Color="{StaticResource StageColor}"/>
  <SolidColorBrush x:Key="DeepBrush" Color="{StaticResource DeepColor}"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
  <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
  <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}"/>
  <SolidColorBrush x:Key="LineStrongBrush" Color="{StaticResource LineStrongColor}"/>
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>
  <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleColor}"/>
  <SolidColorBrush x:Key="PurpleLightBrush" Color="{StaticResource PurpleLightColor}"/>
  <SolidColorBrush x:Key="ReadyBrush" Color="{StaticResource ReadyColor}"/>
  <SolidColorBrush x:Key="CautionBrush" Color="{StaticResource CautionColor}"/>
  <SolidColorBrush x:Key="CoralBrush" Color="{StaticResource CoralColor}"/>

  <!-- Recursos Canônicos do ToggleSwitch no Dark Competitive UI -->
  <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource PurpleColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource PurpleLightColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource PurpleColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource PurpleColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="White"/>

  <!-- Tipografia: Segoe UI Variable como fonte primária para nitidez vetorial total em 96 DPI -->
  <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI, ms-appx:///Assets/Fonts/barlow_regular.ttf#Barlow, sans-serif</FontFamily>
  <FontFamily x:Key="HeadingFont">Segoe UI Variable Display, Segoe UI, ms-appx:///Assets/Fonts/barlow_semicondensed_bold.ttf#Barlow Semi Condensed, sans-serif</FontFamily>
  <FontFamily x:Key="MetricFont">Chakra Petch, Cascadia Mono, Consolas, monospace</FontFamily>
  <FontFamily x:Key="TechnicalFont">Cascadia Mono, Consolas, monospace</FontFamily>

  <!-- Estilos de Texto -->
  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
  </Style>
  <Style x:Key="EyebrowTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
  </Style>
  <Style x:Key="PageTitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
    <Setter Property="FontSize" Value="26"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
  </Style>
  <Style x:Key="HeroTitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
    <Setter Property="FontSize" Value="46"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
  </Style>

  <!-- Estilos de Botão Sólidos (Sem contorno de arame para eliminar serrilhado em 96 DPI) -->
  <Style x:Key="NavButtonStyle" TargetType="Button">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="MinHeight" Value="46"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,3"/>
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="12"/>
  </Style>

  <Style x:Key="PillPrimaryButtonStyle" TargetType="Button">
    <Setter Property="MinHeight" Value="50"/>
    <Setter Property="Padding" Value="32,0"/>
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Background" Value="{StaticResource PurpleBrush}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="25"/>
  </Style>

  <Style x:Key="CircleIconButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="44"/>
    <Setter Property="Height" Value="44"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="#252A36"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="22"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <Style x:Key="SecondaryButtonStyle" TargetType="Button">
    <Setter Property="MinHeight" Value="44"/>
    <Setter Property="Padding" Value="22,0"/>
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Background" Value="#252A36"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="22"/>
  </Style>

  <Style x:Key="PillChipButtonStyle" TargetType="Button">
    <Setter Property="MinHeight" Value="38"/>
    <Setter Property="Padding" Value="20,0"/>
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Background" Value="#1C212B"/>
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="19"/>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="MinHeight" Value="44"/>
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="16,0"/>
  </Style>
</ResourceDictionary>
