<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Paleta Dark Competitive UI (LagCheck Windows v2) -->
  <Color x:Key="StageColor">#0D0F14</Color>
  <Color x:Key="DeepColor">#11141B</Color>
  <Color x:Key="SurfaceColor">#171B24</Color>
  <Color x:Key="PanelColor">#202633</Color>
  <Color x:Key="LineColor">#0DFFFFFF</Color>
  <Color x:Key="LineStrongColor">#1AFFFFFF</Color>
  <Color x:Key="TextPrimaryColor">#F5F7FC</Color>
  <Color x:Key="TextSecondaryColor">#9AA3B5</Color>
  <Color x:Key="TextTertiaryColor">#687285</Color>
  <Color x:Key="PurpleColor">#7C3AED</Color>
  <Color x:Key="PurpleLightColor">#A78BFA</Color>
  <Color x:Key="ReadyColor">#22C55E</Color>
  <Color x:Key="CautionColor">#F59E0B</Color>
  <Color x:Key="CoralColor">#FF5A36</Color>

  <!-- Pincéis -->
  <SolidColorBrush x:Key="StageBrush" Color="{StaticResource StageColor}"/>
  <SolidColorBrush x:Key="DeepBrush" Color="{StaticResource DeepColor}"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
  <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
  <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}"/>
  <SolidColorBrush x:Key="LineStrongBrush" Color="{StaticResource LineStrongColor}"/>
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>
  <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleColor}"/>
  <SolidColorBrush x:Key="PurpleLightBrush" Color="{StaticResource PurpleLightColor}"/>
  <SolidColorBrush x:Key="ReadyBrush" Color="{StaticResource ReadyColor}"/>
  <SolidColorBrush x:Key="CautionBrush" Color="{StaticResource CautionColor}"/>
  <SolidColorBrush x:Key="CoralBrush" Color="{StaticResource CoralColor}"/>
  <SolidColorBrush x:Key="TechLabelBrush" Color="#606873"/>
  <SolidColorBrush x:Key="PillSurfaceBrush" Color="#D9252A36"/>
  <SolidColorBrush x:Key="ChipSurfaceBrush" Color="#1C212B"/>

  <!-- ToggleSwitch: pílula de 40x20 com contorno (off) e preenchimento roxo (on) -->
  <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource PurpleColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource PurpleLightColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource PurpleColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource PurpleColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{StaticResource PurpleLightColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="{StaticResource PurpleColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="White"/>
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="White"/>
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="White"/>
  <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="Transparent"/>
  <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="Transparent"/>
  <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="Transparent"/>
  <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="{StaticResource TextSecondaryColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="{StaticResource TextPrimaryColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="{StaticResource TextSecondaryColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="{StaticResource TextSecondaryColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="{StaticResource TextPrimaryColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="{StaticResource TextSecondaryColor}"/>

  <!-- Campos de texto: contorno fino, sem o sublinhado azul de foco do sistema -->
  <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource SurfaceColor}"/>
  <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource SurfaceColor}"/>
  <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource SurfaceColor}"/>
  <SolidColorBrush x:Key="TextControlBorderBrush" Color="#1AFFFFFF"/>
  <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#26FFFFFF"/>
  <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#40A78BFA"/>
  <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="#1AFFFFFF"/>
  <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="#40A78BFA"/>
  <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource TextPrimaryColor}"/>
  <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{StaticResource TextPrimaryColor}"/>
  <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource TextPrimaryColor}"/>
  <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource TextTertiaryColor}"/>
  <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{StaticResource TextTertiaryColor}"/>
  <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{StaticResource TextTertiaryColor}"/>
  <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>

  <!-- ComboBox / ProgressBar -->
  <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource SurfaceColor}"/>
  <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource SurfaceColor}"/>
  <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource SurfaceColor}"/>
  <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#1AFFFFFF"/>
  <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#26FFFFFF"/>
  <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#26FFFFFF"/>
  <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource PanelColor}"/>
  <SolidColorBrush x:Key="ProgressBarBackground" Color="#14FFFFFF"/>

  <!-- Tipografia oficial v2: Barlow Semi Condensed (títulos), Chakra Petch (métricas), Cascadia Mono (rótulos técnicos), Segoe UI Variable (corpo).
       As fontes de título/métrica já são cortes pesados: usar sempre FontWeight Normal para não gerar negrito sintético. -->
  <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
  <FontFamily x:Key="HeadingFont">ms-appx:///Assets/Fonts/barlow_semicondensed_extrabold.ttf#Barlow Semi Condensed ExtraBold</FontFamily>
  <FontFamily x:Key="HeadingBoldFont">ms-appx:///Assets/Fonts/barlow_semicondensed_bold.ttf#Barlow Semi Condensed</FontFamily>
  <FontFamily x:Key="MetricFont">ms-appx:///Assets/Fonts/chakra_petch_semibold.ttf#Chakra Petch SemiBold</FontFamily>
  <FontFamily x:Key="TechnicalFont">Cascadia Mono, Consolas, monospace</FontFamily>

  <!-- Estilos de texto -->
  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
  </Style>
  <Style x:Key="EyebrowTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
  </Style>
  <Style x:Key="TechLabelStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TechnicalFont}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="CharacterSpacing" Value="100"/>
    <Setter Property="Foreground" Value="{StaticResource TechLabelBrush}"/>
  </Style>
  <Style x:Key="PageTitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="FontSize" Value="26"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
  </Style>
  <Style x:Key="DisplayTitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
  </Style>
  <Style x:Key="HeroTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource DisplayTitleStyle}">
    <Setter Property="FontSize" Value="46"/>
  </Style>
  <Style x:Key="MetricTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MetricFont}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
  </Style>

  <!-- Card premium: degradê discreto, filete de luz e cantos de 20 -->
  <LinearGradientBrush x:Key="PremiumCardBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#1B202B" Offset="0"/>
    <GradientStop Color="#151922" Offset="1"/>
  </LinearGradientBrush>
  <Style x:Key="PremiumCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource PremiumCardBrush}"/>
    <Setter Property="BorderBrush" Value="#14FFFFFF"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="20"/>
  </Style>

  <!-- Template plano de botão: cor sólida + véu claro no hover/pressed, sem bordas nem animações do sistema -->
  <ControlTemplate x:Key="FlatButtonTemplate" TargetType="Button">
    <Grid x:Name="RootGrid">
      <Border x:Name="Fill" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"/>
      <Border x:Name="Veil" Background="White" Opacity="0" IsHitTestVisible="False" CornerRadius="{TemplateBinding CornerRadius}">
        <Border.OpacityTransition><ScalarTransition Duration="0:0:0.18"/></Border.OpacityTransition>
      </Border>
      <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                        Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal"/>
          <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Veil.Opacity" Value="0.08"/></VisualState.Setters></VisualState>
          <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Veil.Opacity" Value="0.14"/></VisualState.Setters></VisualState>
          <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="RootGrid.Opacity" Value="0.45"/></VisualState.Setters></VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
    </Grid>
  </ControlTemplate>

  <ControlTemplate x:Key="SearchNavButtonTemplate" TargetType="Button">
    <Grid x:Name="RootGrid">
      <Border x:Name="Fill" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"/>
      <Border x:Name="Veil" Background="White" Opacity="0" IsHitTestVisible="False" CornerRadius="{TemplateBinding CornerRadius}">
        <Border.OpacityTransition><ScalarTransition Duration="0:0:0.18"/></Border.OpacityTransition>
      </Border>
      <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                        Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal"/>
          <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="RootGrid.Opacity" Value="0.45"/></VisualState.Setters></VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
    </Grid>
  </ControlTemplate>

  <!-- Navegação lateral: o v2 só marca o item ativo (sem véu no hover) -->
  <ControlTemplate x:Key="NavButtonTemplate" TargetType="Button">
    <Grid x:Name="RootGrid">
      <Border x:Name="Fill" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"/>
      <Border x:Name="Veil" Background="White" Opacity="0" IsHitTestVisible="False" CornerRadius="{TemplateBinding CornerRadius}">
        <Border.OpacityTransition><ScalarTransition Duration="0:0:0.18"/></Border.OpacityTransition>
      </Border>
      <!-- Barra de destaque do item ativo (BorderBrush transparente quando inativo) -->
      <Border x:Name="Accent" Width="3" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-1,0,0,0"
              CornerRadius="2" Background="{TemplateBinding BorderBrush}"/>
      <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal"/>
          <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="RootGrid.Opacity" Value="0.45"/></VisualState.Setters></VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
    </Grid>
  </ControlTemplate>

  <Style TargetType="Button">
    <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="Background" Value="#252A36"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="24,0"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <Style x:Key="NavButtonStyle" TargetType="Button">
    <Setter Property="Template" Value="{StaticResource NavButtonTemplate}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Height" Value="44"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,3"/>
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="CornerRadius" Value="12"/>
  </Style>
  <Style x:Key="SearchNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
    <Setter Property="Template" Value="{StaticResource SearchNavButtonTemplate}"/>
  </Style>

  <Style x:Key="PillPrimaryButtonStyle" TargetType="Button">
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="#33FFFFFF"/>
    <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
    <Setter Property="Height" Value="56"/>
    <Setter Property="Padding" Value="42,0"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="CharacterSpacing" Value="25"/>
    <Setter Property="Background" Value="{StaticResource PurpleBrush}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="CornerRadius" Value="28"/>
  </Style>

  <Style x:Key="GhostPillButtonStyle" TargetType="Button">
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="#17FFFFFF"/>
    <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
    <Setter Property="Height" Value="56"/>
    <Setter Property="Padding" Value="32,0"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Background" Value="{StaticResource PillSurfaceBrush}"/>
    <Setter Property="CornerRadius" Value="28"/>
  </Style>

  <Style x:Key="CircleIconButtonStyle" TargetType="Button">
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="#17FFFFFF"/>
    <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="46"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="{StaticResource PillSurfaceBrush}"/>
    <Setter Property="CornerRadius" Value="23"/>
  </Style>

  <Style x:Key="SecondaryButtonStyle" TargetType="Button">
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="#17FFFFFF"/>
    <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
    <Setter Property="MinHeight" Value="44"/>
    <Setter Property="Padding" Value="28,0"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Background" Value="#252A36"/>
    <Setter Property="CornerRadius" Value="22"/>
  </Style>

  <!-- Variante compacta do secundário (Procurar jogos, Medir agora): mesmo respiro lateral, altura menor -->
  <Style x:Key="SecondaryCompactButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
    <Setter Property="Height" Value="40"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="Padding" Value="26,0"/>
    <Setter Property="CornerRadius" Value="20"/>
  </Style>

  <Style x:Key="PillChipButtonStyle" TargetType="Button">
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="#17FFFFFF"/>
    <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
    <Setter Property="Height" Value="38"/>
    <Setter Property="Padding" Value="22,0"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Background" Value="{StaticResource ChipSurfaceBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    <Setter Property="CornerRadius" Value="19"/>
  </Style>

  <!-- Link roxo sem fundo (Cancelar, Escolher outro jogo) -->
  <Style x:Key="TextLinkButtonStyle" TargetType="Button">
    <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource PurpleLightBrush}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="MinHeight" Value="44"/>
    <Setter Property="CornerRadius" Value="10"/>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="MinHeight" Value="44"/>
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="16,11,16,0"/>
  </Style>
</ResourceDictionary>
