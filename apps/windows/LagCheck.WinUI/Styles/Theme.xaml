<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Paleta Dark Competitive UI (LagCheck Windows v2) -->
  <Color x:Key="StageColor">#000000</Color>
  <Color x:Key="DeepColor">#000000</Color>
  <Color x:Key="SurfaceColor">#171B24</Color>
  <Color x:Key="PanelColor">#202633</Color>
  <Color x:Key="LineColor">#0DFFFFFF</Color>
  <Color x:Key="LineStrongColor">#1AFFFFFF</Color>
  <Color x:Key="TextPrimaryColor">#F5F7FC</Color>
  <Color x:Key="TextSecondaryColor">#9AA3B5</Color>
  <Color x:Key="TextTertiaryColor">#8F99AB</Color>
  <Color x:Key="PurpleColor">#7C3AED</Color>
  <Color x:Key="PurpleLightColor">#A78BFA</Color>
  <Color x:Key="ReadyColor">#22C55E</Color>
  <Color x:Key="CautionColor">#F59E0B</Color>
  <Color x:Key="CoralColor">#FF5A36</Color>
  <Color x:Key="GlassColor">#B8141828</Color>
  <Color x:Key="GlassStrongColor">#E0141828</Color>

  <!-- Pincéis -->
  <SolidColorBrush x:Key="StageBrush" Color="{StaticResource StageColor}"/>
  <SolidColorBrush x:Key="DeepBrush" Color="{StaticResource DeepColor}"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
  <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
  <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}"/>
  <SolidColorBrush x:Key="LineStrongBrush" Color="{StaticResource LineStrongColor}"/>
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>
  <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleColor}"/>
  <SolidColorBrush x:Key="PurpleLightBrush" Color="{StaticResource PurpleLightColor}"/>
  <SolidColorBrush x:Key="ReadyBrush" Color="{StaticResource ReadyColor}"/>
  <SolidColorBrush x:Key="CautionBrush" Color="{StaticResource CautionColor}"/>
  <SolidColorBrush x:Key="CoralBrush" Color="{StaticResource CoralColor}"/>
  <SolidColorBrush x:Key="TechLabelBrush" Color="#8791A3"/>
  <SolidColorBrush x:Key="GlassBrush" Color="{StaticResource GlassColor}"/>
  <SolidColorBrush x:Key="GlassStrongBrush" Color="{StaticResource GlassStrongColor}"/>
  <SolidColorBrush x:Key="GlassBorderBrush" Color="#1FFFFFFF"/>
  <SolidColorBrush x:Key="PillSurfaceBrush" Color="#B8252A36"/>
  <SolidColorBrush x:Key="ChipSurfaceBrush" Color="#B81C212B"/>
  <LinearGradientBrush x:Key="SurfaceElevatedBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#EB212734" Offset="0"/>
    <GradientStop Color="#EB151922" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ChipElevatedBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#E61D222E" Offset="0"/>
    <GradientStop Color="#E612161F" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="SurfaceDepthBorderBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#2EFFFFFF" Offset="0"/>
    <GradientStop Color="#12FFFFFF" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="HomeHeroCtaBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#8B5CF6" Offset="0"/>
    <GradientStop Color="#7C3AED" Offset="0.52"/>
    <GradientStop Color="#6D28D9" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="HomeHeroCtaRingBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#40FFFFFF" Offset="0"/>
    <GradientStop Color="#36A78BFA" Offset="1"/>
  </LinearGradientBrush>

  <!-- ToggleSwitch: pílula de 40x20 com contorno (off) e preenchimento roxo (on) -->
  <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource PurpleColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource PurpleLightColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource PurpleColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource PurpleColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{StaticResource PurpleLightColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="{StaticResource PurpleColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="White"/>
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="White"/>
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="White"/>
  <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="Transparent"/>
  <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="Transparent"/>
  <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="Transparent"/>
  <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="{StaticResource TextSecondaryColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="{StaticResource TextPrimaryColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="{StaticResource TextSecondaryColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="{StaticResource TextSecondaryColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="{StaticResource TextPrimaryColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="{StaticResource TextSecondaryColor}"/>

  <!-- Campos de texto: contorno fino, sem o sublinhado azul de foco do sistema -->
  <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource GlassColor}"/>
  <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource GlassColor}"/>
  <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource GlassColor}"/>
  <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#80141828"/>
  <SolidColorBrush x:Key="TextControlBorderBrush" Color="#1AFFFFFF"/>
  <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#26FFFFFF"/>
  <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#40A78BFA"/>
  <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="#1AFFFFFF"/>
  <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="#40A78BFA"/>
  <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource TextPrimaryColor}"/>
  <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{StaticResource TextPrimaryColor}"/>
  <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource TextPrimaryColor}"/>
  <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource TextTertiaryColor}"/>
  <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{StaticResource TextTertiaryColor}"/>
  <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{StaticResource TextTertiaryColor}"/>
  <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>

  <!-- ComboBox / ProgressBar -->
  <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource GlassColor}"/>
  <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource GlassColor}"/>
  <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource GlassColor}"/>
  <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#80141828"/>
  <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#1AFFFFFF"/>
  <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#26FFFFFF"/>
  <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#26FFFFFF"/>
  <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#202633"/>
  <SolidColorBrush x:Key="ProgressBarBackground" Color="#14FFFFFF"/>

  <!-- Tipografia oficial v2 (Tríade Android / Decisão 125):
       1. Display: Barlow Semi Condensed (títulos e vereditos)
       2. Corpo: Barlow Regular / Medium / SemiBold (leitura, navegação, botões e campos)
       3. Telemetria: Chakra Petch SemiBold (métricas, números e kickers técnicos com algarismos tabulares)
       As fontes de corte específico já possuem seus pesos: usar sempre FontWeight Normal para não gerar negrito sintético. -->
  <FontFamily x:Key="BodyFont">ms-appx:///Assets/Fonts/barlow_regular.ttf#Barlow</FontFamily>
  <FontFamily x:Key="BodyMediumFont">ms-appx:///Assets/Fonts/barlow_medium.ttf#Barlow Medium</FontFamily>
  <FontFamily x:Key="BodySemiBoldFont">ms-appx:///Assets/Fonts/barlow_semibold.ttf#Barlow SemiBold</FontFamily>
  <FontFamily x:Key="HeadingFont">ms-appx:///Assets/Fonts/barlow_semicondensed_extrabold.ttf#Barlow Semi Condensed ExtraBold</FontFamily>
  <FontFamily x:Key="HeadingBoldFont">ms-appx:///Assets/Fonts/barlow_semicondensed_bold.ttf#Barlow Semi Condensed</FontFamily>
  <FontFamily x:Key="MetricFont">ms-appx:///Assets/Fonts/chakra_petch_semibold.ttf#Chakra Petch SemiBold</FontFamily>
  <FontFamily x:Key="TechnicalFont">ms-appx:///Assets/Fonts/chakra_petch_semibold.ttf#Chakra Petch SemiBold</FontFamily>

  <!-- Estilos de texto -->
  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
  </Style>
  <Style x:Key="BodyMediumTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodyMediumFont}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
  </Style>
  <Style x:Key="BodySemiBoldTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodySemiBoldFont}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
  </Style>
  <Style x:Key="EyebrowTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource BodySemiBoldFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
  </Style>
  <Style x:Key="TechLabelStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TechnicalFont}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="CharacterSpacing" Value="70"/>
    <Setter Property="Foreground" Value="{StaticResource TechLabelBrush}"/>
  </Style>
  <Style x:Key="PageTitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource HeadingBoldFont}"/>
    <Setter Property="FontSize" Value="26"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
  </Style>
  <Style x:Key="PageHeaderStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="FontSize" Value="36"/>
    <Setter Property="LineHeight" Value="36"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
  </Style>
  <Style x:Key="DisplayTitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
  </Style>
  <Style x:Key="HeroTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource DisplayTitleStyle}">
    <Setter Property="FontSize" Value="46"/>
  </Style>
  <Style x:Key="MetricTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MetricFont}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
  </Style>

  <!-- Padding padrão de páginas sobre o papel de parede -->
  <Thickness x:Key="PagePadding">48,24,48,40</Thickness>

  <!-- Card premium: degradê translúcido, filete de luz e cantos de 20 -->
  <LinearGradientBrush x:Key="PremiumCardBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#B81B2030" Offset="0"/>
    <GradientStop Color="#B8151A28" Offset="1"/>
  </LinearGradientBrush>
  <Style x:Key="PremiumCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource PremiumCardBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource SurfaceDepthBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
  </Style>
  <Style x:Key="GlassCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource GlassBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource SurfaceDepthBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="20"/>
  </Style>

  <!-- Template plano de botão: cor sólida + véu claro no hover/pressed, sem bordas nem animações do sistema -->
  <ControlTemplate x:Key="FlatButtonTemplate" TargetType="Button">
    <Grid x:Name="RootGrid">
      <Border x:Name="Fill" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"/>
      <Border x:Name="Veil" Background="White" Opacity="0" IsHitTestVisible="False" CornerRadius="{TemplateBinding CornerRadius}"/>
      <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                        Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.18"/></VisualStateGroup.Transitions>
          <VisualState x:Name="Normal"/>
          <VisualState x:Name="PointerOver"><Storyboard><DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0"/></Storyboard></VisualState>
          <VisualState x:Name="Pressed"><Storyboard><DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity" To="0.14" Duration="0"/></Storyboard></VisualState>
          <VisualState x:Name="Disabled"><Storyboard><DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0"/></Storyboard></VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
    </Grid>
  </ControlTemplate>

  <ControlTemplate x:Key="HomeHeroCtaButtonTemplate" TargetType="Button">
    <Grid x:Name="RootGrid">
      <Border x:Name="Fill" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"/>
      <Border x:Name="Veil" Background="White" Opacity="0" IsHitTestVisible="False" CornerRadius="{TemplateBinding CornerRadius}"/>
      <Border x:Name="PressedVeil" Background="Black" Opacity="0" IsHitTestVisible="False" CornerRadius="{TemplateBinding CornerRadius}"/>
      <Border x:Name="HoverRing" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False"/>
      <Border x:Name="FocusRing" BorderBrush="{StaticResource PurpleLightBrush}" BorderThickness="2" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False"/>
      <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                        Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.18"/></VisualStateGroup.Transitions>
          <VisualState x:Name="Normal"/>
          <VisualState x:Name="PointerOver"><Storyboard><DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity" To="0.10" Duration="0"/><DoubleAnimation Storyboard.TargetName="HoverRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/></Storyboard></VisualState>
          <VisualState x:Name="Pressed"><Storyboard><DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity" To="0.02" Duration="0"/><DoubleAnimation Storyboard.TargetName="PressedVeil" Storyboard.TargetProperty="Opacity" To="0.18" Duration="0"/></Storyboard></VisualState>
          <VisualState x:Name="Disabled"><Storyboard><DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0"/></Storyboard></VisualState>
        </VisualStateGroup>
        <VisualStateGroup x:Name="FocusStates">
          <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.18"/></VisualStateGroup.Transitions>
          <VisualState x:Name="Unfocused"/>
          <VisualState x:Name="PointerFocused"><Storyboard><DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/></Storyboard></VisualState>
          <VisualState x:Name="Focused"><Storyboard><DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/></Storyboard></VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
    </Grid>
  </ControlTemplate>

  <ControlTemplate x:Key="HeroPrimaryButtonTemplate" TargetType="Button">
    <Grid x:Name="RootGrid" UseLayoutRounding="True">
      <Border x:Name="OuterRing" BorderBrush="{StaticResource HomeHeroCtaRingBrush}" BorderThickness="1" CornerRadius="{TemplateBinding CornerRadius}"/>
      <Border x:Name="Fill" Margin="4" Background="{TemplateBinding Background}" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12"/>
      <Border x:Name="Veil" Margin="4" Background="White" Opacity="0" IsHitTestVisible="False" CornerRadius="12"/>
      <Border x:Name="PressedVeil" Margin="4" Background="Black" Opacity="0" IsHitTestVisible="False" CornerRadius="12"/>
      <Border x:Name="FocusRing" BorderBrush="{StaticResource PurpleLightBrush}" BorderThickness="2" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False"/>
      <Grid Margin="4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="44"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="44"/>
        </Grid.ColumnDefinitions>
        <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                          Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        <Grid Grid.Column="2" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border CornerRadius="8" Background="White"/>
          <FontIcon Glyph="&#xE72A;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{StaticResource PurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
      </Grid>
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.18"/></VisualStateGroup.Transitions>
          <VisualState x:Name="Normal"/>
          <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="OuterRing.BorderBrush" Value="#8CA78BFA"/></VisualState.Setters><Storyboard><DoubleAnimation Storyboard.TargetName="Veil" Storyboard.TargetProperty="Opacity" To="0.10" Duration="0"/></Storyboard></VisualState>
          <VisualState x:Name="Pressed"><Storyboard><DoubleAnimation Storyboard.TargetName="PressedVeil" Storyboard.TargetProperty="Opacity" To="0.18" Duration="0"/></Storyboard></VisualState>
          <VisualState x:Name="Disabled"><Storyboard><DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0"/><DoubleAnimation Storyboard.TargetName="OuterRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/></Storyboard></VisualState>
        </VisualStateGroup>
        <VisualStateGroup x:Name="FocusStates">
          <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.18"/></VisualStateGroup.Transitions>
          <VisualState x:Name="Unfocused"/>
          <VisualState x:Name="PointerFocused"><Storyboard><DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/></Storyboard></VisualState>
          <VisualState x:Name="Focused"><Storyboard><DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/></Storyboard></VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
    </Grid>
  </ControlTemplate>

  <Style TargetType="Button">
    <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="Background" Value="{StaticResource PillSurfaceBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="24,0"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <Style x:Key="PillPrimaryButtonStyle" TargetType="Button">
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="#33FFFFFF"/>
    <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
    <Setter Property="FontFamily" Value="{StaticResource BodySemiBoldFont}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Height" Value="56"/>
    <Setter Property="Padding" Value="42,0"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="CharacterSpacing" Value="25"/>
    <Setter Property="Background" Value="{StaticResource PurpleBrush}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="CornerRadius" Value="12"/>
  </Style>

  <!-- CTA exclusivo do Hero da Home: o anel externo separa a ação principal dos demais botões. -->
  <Style x:Key="HomeHeroCtaButtonStyle" TargetType="Button">
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="#33FFFFFF"/>
    <Setter Property="Template" Value="{StaticResource HomeHeroCtaButtonTemplate}"/>
    <Setter Property="FontFamily" Value="{StaticResource BodySemiBoldFont}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Height" Value="48"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="CharacterSpacing" Value="25"/>
    <Setter Property="Background" Value="{StaticResource HomeHeroCtaBrush}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="CornerRadius" Value="12"/>
  </Style>

  <Style x:Key="HeroPrimaryButtonStyle" TargetType="Button">
    <Setter Property="Template" Value="{StaticResource HeroPrimaryButtonTemplate}"/>
    <Setter Property="FontFamily" Value="{StaticResource BodySemiBoldFont}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="MinWidth" Value="240"/>
    <Setter Property="Height" Value="56"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="CharacterSpacing" Value="25"/>
    <Setter Property="Background" Value="{StaticResource HomeHeroCtaBrush}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="CornerRadius" Value="16"/>
  </Style>

  <Style x:Key="GhostPillButtonStyle" TargetType="Button">
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{StaticResource SurfaceDepthBorderBrush}"/>
    <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
    <Setter Property="FontFamily" Value="{StaticResource BodySemiBoldFont}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Height" Value="52"/>
    <Setter Property="Padding" Value="32,0"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
    <Setter Property="CornerRadius" Value="12"/>
  </Style>

  <Style x:Key="CircleIconButtonStyle" TargetType="Button">
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{StaticResource SurfaceDepthBorderBrush}"/>
    <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="46"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
    <Setter Property="CornerRadius" Value="12"/>
  </Style>

  <Style x:Key="SecondaryButtonStyle" TargetType="Button">
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{StaticResource SurfaceDepthBorderBrush}"/>
    <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
    <Setter Property="FontFamily" Value="{StaticResource BodySemiBoldFont}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="MinHeight" Value="44"/>
    <Setter Property="Padding" Value="28,0"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
    <Setter Property="CornerRadius" Value="12"/>
  </Style>

  <!-- Variante compacta do secundário (Procurar jogos, Medir agora): mesmo respiro lateral, altura menor -->
  <Style x:Key="SecondaryCompactButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
    <Setter Property="Height" Value="40"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="Padding" Value="26,0"/>
    <Setter Property="CornerRadius" Value="10"/>
  </Style>

  <Style x:Key="PillChipButtonStyle" TargetType="Button">
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{StaticResource SurfaceDepthBorderBrush}"/>
    <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
    <Setter Property="FontFamily" Value="{StaticResource BodyMediumFont}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Background" Value="{StaticResource ChipElevatedBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>

  <!-- Link roxo sem fundo (Cancelar, Escolher outro jogo) -->
  <Style x:Key="TextLinkButtonStyle" TargetType="Button">
    <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
