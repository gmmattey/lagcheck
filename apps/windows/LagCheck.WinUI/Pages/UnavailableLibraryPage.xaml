<Page x:Class="LagCheck.WinUI.Pages.UnavailableLibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource DeepBrush}">
  <Grid Padding="38,32,38,48">
    <StackPanel MaxWidth="560" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
      <TextBlock x:Name="EyebrowText" Text="INTEGRAÇÃO LOCAL" Foreground="{StaticResource PurpleLightBrush}" Style="{StaticResource EyebrowTextStyle}" TextAlignment="Center"/>
      <TextBlock x:Name="TitleText" Text="Biblioteca em integração" Style="{StaticResource PageTitleStyle}" TextAlignment="Center" />
      <TextBlock x:Name="DescText" Text="A leitura local dos jogos instalados ainda não foi conectada à interface WinUI. Nenhum jogo é exibido até a fonte real ficar disponível." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" FontSize="15" />
    </StackPanel>
  </Grid>
</Page>
