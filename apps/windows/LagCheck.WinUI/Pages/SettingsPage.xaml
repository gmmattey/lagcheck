<Page x:Class="LagCheck.WinUI.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ctl="using:LagCheck.WinUI.Controls"
      Background="Transparent">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Padding="40,32,40,80" Spacing="20">

      <TextBlock x:Name="HeaderTitle" Text="Ajustes" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,8"/>

      <!-- Interface e Visual -->
      <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="24,20">
        <StackPanel Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ctl:SvgIcon Data="M12 3a9 9 0 1 0 9 9c0-1-1-1.5-2-1.5h-2a2 2 0 0 1-2-2V6c0-1.5-1-3-3-3z" Size="18" Foreground="{StaticResource PurpleLightBrush}"/>
            <TextBlock x:Name="VisualCardTitle" Text="Interface e Visual" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>

          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ReduceMotionTitle" Text="Reduzir movimento" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
            <ToggleSwitch x:Name="ReduceMotionSwitch" Grid.Column="1" IsEnabled="False" Toggled="Preference_Toggled" Tag="reduceMotion" OffContent="" OnContent="" MinWidth="0" VerticalAlignment="Center"/>
          </Grid>

          <Border Background="#0DFFFFFF" Height="1"/>

          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ArtworkTitle" Text="Baixar imagens dos jogos" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
            <ToggleSwitch x:Name="ArtworkSwitch" Grid.Column="1" IsEnabled="False" Toggled="Preference_Toggled" Tag="artworkDownload" OffContent="" OnContent="" MinWidth="0" VerticalAlignment="Center"/>
          </Grid>

          <Border Background="#0DFFFFFF" Height="1"/>

          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="LanguageTitle" Text="Idioma do aplicativo" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
            <ComboBox x:Name="LanguageComboBox" Grid.Column="1" MinWidth="200" SelectionChanged="LanguageComboBox_SelectionChanged" Height="40" CornerRadius="12">
              <ComboBoxItem x:Name="LangItemSystem" Content="Sistema (Padrão)" Tag="system"/>
              <ComboBoxItem Content="Português (Brasil)" Tag="pt-BR"/>
              <ComboBoxItem Content="English" Tag="en"/>
              <ComboBoxItem Content="Español" Tag="es"/>
            </ComboBox>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Privacidade e Rede -->
      <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="24,20">
        <StackPanel Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ctl:SvgIcon Data="M12 2l8 3v6c0 5-3.5 9-8 11-4.5-2-8-6-8-11V5z" Size="18" Foreground="{StaticResource PurpleLightBrush}"/>
            <TextBlock x:Name="NetworkCardTitle" Text="Privacidade e Rede" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>

          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="LocationTitle" Text="Localização aproximada" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
            <ToggleSwitch x:Name="ApproximateLocationSwitch" Grid.Column="1" IsEnabled="False" Toggled="Preference_Toggled" Tag="approximateLocation" OffContent="" OnContent="" MinWidth="0" VerticalAlignment="Center"/>
          </Grid>

          <Border Background="#0DFFFFFF" Height="1"/>

          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="AnalyticsTitle" Text="Enviar estatísticas anônimas" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
            <ToggleSwitch x:Name="AnalyticsSwitch" Grid.Column="1" IsEnabled="False" Toggled="Preference_Toggled" Tag="analytics" OffContent="" OnContent="" MinWidth="0" VerticalAlignment="Center"/>
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,4,0,0">
            <Button x:Name="RenewAnalyticsIdButton" Content="Gerar novo ID local" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" Click="RenewAnalyticsId_Click"/>
            <TextBlock x:Name="AnalyticsStatus" Foreground="{StaticResource TextTertiaryBrush}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Atualizações -->
      <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="24,20">
        <StackPanel Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ctl:SvgIcon Data="M20 12a8 8 0 1 1-2.3-5.7M20 4v5h-5" Size="18" Foreground="{StaticResource PurpleLightBrush}"/>
            <TextBlock x:Name="UpdatesCardTitle" Text="Atualizações" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>

          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="AutoUpdatesTitle" Text="Verificar automaticamente" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
            <ToggleSwitch x:Name="AutomaticUpdatesSwitch" Grid.Column="1" IsEnabled="False" Toggled="Preference_Toggled" Tag="automaticUpdates" OffContent="" OnContent="" MinWidth="0" VerticalAlignment="Center"/>
          </Grid>

          <Border Background="#0DFFFFFF" Height="1"/>

          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="UpdateStatus" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button x:Name="CheckUpdatesButton" Grid.Column="1" Content="Verificar agora" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" Click="CheckUpdates_Click"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Sobre -->
      <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="24,20">
        <StackPanel Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ctl:SvgIcon Data="M12 8v.01M12 11v6M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z" Size="18" Foreground="{StaticResource PurpleLightBrush}"/>
            <TextBlock x:Name="AboutCardTitle" Text="Sobre o LagCheck" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="AboutVersion" Text="Versão v0.1.0 · WinUI 3 (x64) · Repositório Oficial" FontFamily="{StaticResource TechnicalFont}" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Page>
