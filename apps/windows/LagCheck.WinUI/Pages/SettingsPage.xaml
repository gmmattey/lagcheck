<Page x:Class="LagCheck.WinUI.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ctl="using:LagCheck.WinUI.Controls"
      xmlns:automation="using:Microsoft.UI.Xaml.Automation"
      Background="#B9000000" KeyDown="SettingsPage_KeyDown">
  <Page.Resources>
    <Style x:Key="SettingsSectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>
    <Style x:Key="SettingsRowTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Page.Resources>
  <Grid Padding="24,20,24,24">
    <Border MaxWidth="680" MaxHeight="760" HorizontalAlignment="Stretch" VerticalAlignment="Center"
            Background="{StaticResource GlassStrongBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="20">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="#29323B49" CornerRadius="19,19,0,0" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" Padding="20,0">
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ctl:SvgIcon Data="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l2 2" Size="16" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="HeaderTitle" Grid.Column="1" Text="Ajustes" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button x:Name="CloseButton" Grid.Column="2" MinWidth="44" MinHeight="44" Padding="0" Background="Transparent" BorderThickness="0" Click="Close_Click" automation:AutomationProperties.Name="Voltar ao início">
              <FontIcon Glyph="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="13"/>
            </Button>
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,12,24,20">
          <StackPanel>
            <TextBlock x:Name="VisualCardTitle" Text="Interface e Visual" Style="{StaticResource SettingsSectionTitle}" Margin="0,10,0,8"/>
            <Grid MinHeight="56" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock x:Name="ReduceMotionTitle" Text="Reduzir movimento" Style="{StaticResource SettingsRowTitle}"/><TextBlock x:Name="ReduceMotionDesc" Text="Remove transições e a rotação automática de arte." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/></StackPanel><ToggleSwitch x:Name="ReduceMotionSwitch" Grid.Column="1" IsEnabled="False" Toggled="Preference_Toggled" Tag="reduceMotion" OffContent="" OnContent="" MinWidth="0" VerticalAlignment="Center"/></Grid>
            <Border Height="1" Background="#1AFFFFFF"/>
            <Grid MinHeight="56" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock x:Name="ArtworkTitle" Text="Baixar imagens dos jogos" Style="{StaticResource SettingsRowTitle}"/><TextBlock x:Name="ArtworkDesc" Text="Baixa capas e banners das lojas. Desligado, só usa o que já existe no PC." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/></StackPanel><ToggleSwitch x:Name="ArtworkSwitch" Grid.Column="1" IsEnabled="False" Toggled="Preference_Toggled" Tag="artworkDownload" OffContent="" OnContent="" MinWidth="0" VerticalAlignment="Center"/></Grid>
            <Border Height="1" Background="#1AFFFFFF"/>
            <Grid MinHeight="58" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="LanguageTitle" Text="Idioma do aplicativo" Style="{StaticResource SettingsRowTitle}"/><ComboBox x:Name="LanguageComboBox" Grid.Column="1" MinWidth="160" MaxWidth="210" SelectionChanged="LanguageComboBox_SelectionChanged" MinHeight="40" CornerRadius="6"><ComboBoxItem x:Name="LangItemSystem" Content="Sistema (Padrão)" Tag="system"/><ComboBoxItem Content="Português (Brasil)" Tag="pt-BR"/><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="Español" Tag="es"/></ComboBox></Grid>
            <Border Height="1" Background="#29FFFFFF" Margin="0,8,0,0"/>

            <TextBlock x:Name="NetworkCardTitle" Text="Privacidade e Rede" Style="{StaticResource SettingsSectionTitle}" Margin="0,20,0,8"/>
            <Grid MinHeight="56" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock x:Name="LocationTitle" Text="Localização aproximada" Style="{StaticResource SettingsRowTitle}"/><TextBlock x:Name="LocationDesc" Text="Usada só para centralizar o mapa da rota. Fica neste PC." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/></StackPanel><ToggleSwitch x:Name="ApproximateLocationSwitch" Grid.Column="1" IsEnabled="False" Toggled="Preference_Toggled" Tag="approximateLocation" OffContent="" OnContent="" MinWidth="0" VerticalAlignment="Center"/></Grid>
            <Border Height="1" Background="#1AFFFFFF"/>
            <Grid MinHeight="56" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock x:Name="AnalyticsTitle" Text="Enviar estatísticas anônimas" Style="{StaticResource SettingsRowTitle}"/><TextBlock x:Name="AnalyticsDesc" Text="Dados anônimos de uso. Você pode desligar quando quiser." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/></StackPanel><ToggleSwitch x:Name="AnalyticsSwitch" Grid.Column="1" IsEnabled="False" Toggled="Preference_Toggled" Tag="analytics" OffContent="" OnContent="" MinWidth="0" VerticalAlignment="Center"/></Grid>
            <Grid MinHeight="52" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="AnalyticsStatus" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/><Button x:Name="RenewAnalyticsIdButton" Grid.Column="1" Content="Gerar novo ID local" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" MinHeight="40" Click="RenewAnalyticsId_Click"/></Grid>
            <Border Height="1" Background="#29FFFFFF" Margin="0,8,0,0"/>

            <TextBlock x:Name="UpdatesCardTitle" Text="Atualizações" Style="{StaticResource SettingsSectionTitle}" Margin="0,20,0,8"/>
            <Grid MinHeight="56" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock x:Name="AutoUpdatesTitle" Text="Verificar automaticamente" Style="{StaticResource SettingsRowTitle}"/><TextBlock x:Name="AutoUpdatesDesc" Text="Procura novas versões ao abrir o app." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/></StackPanel><ToggleSwitch x:Name="AutomaticUpdatesSwitch" Grid.Column="1" IsEnabled="False" Toggled="Preference_Toggled" Tag="automaticUpdates" OffContent="" OnContent="" MinWidth="0" VerticalAlignment="Center"/></Grid>
            <Border Height="1" Background="#1AFFFFFF"/>
            <Grid MinHeight="58" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="UpdateStatus" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/><Button x:Name="CheckUpdatesButton" Grid.Column="1" Content="Verificar agora" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" MinHeight="40" Click="CheckUpdates_Click"/></Grid>
            <Border Height="1" Background="#29FFFFFF" Margin="0,8,0,0"/>

            <TextBlock x:Name="AboutCardTitle" Text="Sobre o LagCheck" Style="{StaticResource SettingsSectionTitle}" Margin="0,20,0,10"/>
            <TextBlock x:Name="AboutVersion" Text="Versão v0.1.0 · WinUI 3 (x64) · Repositório Oficial" FontFamily="{StaticResource TechnicalFont}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</Page>
