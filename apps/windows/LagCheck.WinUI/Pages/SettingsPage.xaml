<Page x:Class="LagCheck.WinUI.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ctl="using:LagCheck.WinUI.Controls"
      Background="Transparent"
      KeyDown="SettingsPage_KeyDown"
      SizeChanged="SettingsPage_SizeChanged">
  <Grid>
    <Grid Margin="{StaticResource PagePadding}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Título grande no topo à esquerda sem moldura -->
      <TextBlock x:Name="HeaderTitle"
                 Text="AJUSTES"
                 Style="{StaticResource PageHeaderStyle}"
                 Margin="0,0,0,24"/>

      <!-- Grade principal: categorias à esquerda e linhas à direita -->
      <Grid x:Name="LayoutGrid" Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="CategoriesColDef" Width="300"/>
          <ColumnDefinition x:Name="SpacingColDef" Width="40"/>
          <ColumnDefinition x:Name="ContentColDef" Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition x:Name="TopCategoriesRowDef" Height="Auto"/>
          <RowDefinition x:Name="MainContentRowDef" Height="*"/>
        </Grid.RowDefinitions>

        <!-- Coluna de Categorias -->
        <ScrollViewer x:Name="CategoriesScrollViewer"
                      Grid.Column="0" Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="CategoriesPanel" Spacing="6">
            <ctl:SettingsCategoryButton x:Name="CatScreen" Title="Tela e janela" Selected="Category_Selected"/>
            <ctl:SettingsCategoryButton x:Name="CatAppearance" Title="Aparência e idioma" Selected="Category_Selected"/>
            <ctl:SettingsCategoryButton x:Name="CatGames" Title="Jogos e imagens" Selected="Category_Selected"/>
            <ctl:SettingsCategoryButton x:Name="CatPrivacy" Title="Privacidade e rede" Selected="Category_Selected"/>
            <ctl:SettingsCategoryButton x:Name="CatUpdates" Title="Atualizações" Selected="Category_Selected"/>
            <ctl:SettingsCategoryButton x:Name="CatAbout" Title="Sobre o LagCheck" Selected="Category_Selected"/>
          </StackPanel>
        </ScrollViewer>

        <!-- Coluna de Linhas (Conteúdo da Categoria Ativa) -->
        <ScrollViewer x:Name="ContentScrollViewer"
                      Grid.Column="2" Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,16,0">
          <Grid x:Name="PanelsContainer" HorizontalAlignment="Stretch" VerticalAlignment="Top">

            <!-- Painel: Tela e janela -->
            <StackPanel x:Name="PanelScreen" Spacing="0">
              <ctl:SettingsRow x:Name="RowFullScreenMode"
                               Title="Modo tela cheia"
                               Description="Alterna entre janela e tela cheia. Atalho: F11.">
                <ToggleSwitch x:Name="FullScreenModeSwitch" Toggled="FullScreenModeSwitch_Toggled"/>
              </ctl:SettingsRow>
              <ctl:SettingsRow x:Name="RowStartFullScreen"
                               Title="Abrir em tela cheia"
                               Description="Inicia o LagCheck já em tela cheia.">
                <ToggleSwitch x:Name="StartFullScreenSwitch" Toggled="StartFullScreenSwitch_Toggled"/>
              </ctl:SettingsRow>
            </StackPanel>

            <!-- Painel: Aparência e idioma -->
            <StackPanel x:Name="PanelAppearance" Spacing="0" Visibility="Collapsed">
              <ctl:SettingsRow x:Name="RowReduceMotion"
                               Title="Reduzir movimento"
                               Description="Remove transições e a rotação automática de arte.">
                <ToggleSwitch x:Name="ReduceMotionSwitch"
                              IsEnabled="False"
                              Toggled="Preference_Toggled"
                              Tag="reduceMotion"/>
              </ctl:SettingsRow>
              <ctl:SettingsRow x:Name="RowLanguage"
                               Title="Idioma do aplicativo"
                               Description="Escolha o idioma da interface. Por padrão, segue as configurações do Windows.">
                <ComboBox x:Name="LanguageComboBox"
                          MinWidth="160" MaxWidth="220"
                          SelectionChanged="LanguageComboBox_SelectionChanged"
                          MinHeight="38" CornerRadius="6">
                  <ComboBoxItem x:Name="LangItemSystem" Content="Sistema (Padrão)" Tag="system"/>
                  <ComboBoxItem Content="Português (Brasil)" Tag="pt-BR"/>
                  <ComboBoxItem Content="English" Tag="en"/>
                  <ComboBoxItem Content="Español" Tag="es"/>
                </ComboBox>
              </ctl:SettingsRow>
            </StackPanel>

            <!-- Painel: Jogos e imagens -->
            <StackPanel x:Name="PanelGames" Spacing="0" Visibility="Collapsed">
              <ctl:SettingsRow x:Name="RowArtwork"
                               Title="Baixar imagens dos jogos"
                               Description="Baixa capas e banners das lojas. Desligado, só usa o que já existe no PC.">
                <ToggleSwitch x:Name="ArtworkSwitch"
                              IsEnabled="False"
                              Toggled="Preference_Toggled"
                              Tag="artworkDownload"/>
              </ctl:SettingsRow>
            </StackPanel>

            <!-- Painel: Privacidade e rede -->
            <StackPanel x:Name="PanelPrivacy" Spacing="0" Visibility="Collapsed">
              <ctl:SettingsRow x:Name="RowApproximateLocation"
                               Title="Localização aproximada"
                               Description="Usada só para centralizar o mapa da rota. Fica neste PC.">
                <ToggleSwitch x:Name="ApproximateLocationSwitch"
                              IsEnabled="False"
                              Toggled="Preference_Toggled"
                              Tag="approximateLocation"/>
              </ctl:SettingsRow>
              <ctl:SettingsRow x:Name="RowAnalytics"
                               Title="Enviar estatísticas anônimas"
                               Description="Dados anônimos de uso. Você pode desligar quando quiser.">
                <ToggleSwitch x:Name="AnalyticsSwitch"
                              IsEnabled="False"
                              Toggled="Preference_Toggled"
                              Tag="analytics"/>
              </ctl:SettingsRow>
              <ctl:SettingsRow x:Name="RowRenewAnalyticsId"
                               Title="Gerar novo ID local"
                               Description="">
                <Button x:Name="RenewAnalyticsIdButton"
                        Content="Gerar novo ID local"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="False"
                        MinHeight="36"
                        Click="RenewAnalyticsId_Click"/>
              </ctl:SettingsRow>
            </StackPanel>

            <!-- Painel: Atualizações -->
            <StackPanel x:Name="PanelUpdates" Spacing="0" Visibility="Collapsed">
              <ctl:SettingsRow x:Name="RowAutoUpdates"
                               Title="Verificar automaticamente"
                               Description="Procura novas versões ao abrir o app.">
                <ToggleSwitch x:Name="AutomaticUpdatesSwitch"
                              IsEnabled="False"
                              Toggled="Preference_Toggled"
                              Tag="automaticUpdates"/>
              </ctl:SettingsRow>
              <ctl:SettingsRow x:Name="RowCheckUpdates"
                               Title="Verificar agora"
                               Description="">
                <Button x:Name="CheckUpdatesButton"
                        Content="Verificar agora"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="False"
                        MinHeight="36"
                        Click="CheckUpdates_Click"/>
              </ctl:SettingsRow>
            </StackPanel>

            <!-- Painel: Sobre o LagCheck -->
            <StackPanel x:Name="PanelAbout" Spacing="0" Visibility="Collapsed">
              <ctl:SettingsRow x:Name="RowAbout"
                               Title="Sobre o LagCheck"
                               Description="LagCheck para Windows — Launcher gamer com pre-flight check de rede integrado. Sem conta obrigatória e sem anúncios."
                               ValueText="v0.1.0 · WinUI 3 (x64) · Repositório Oficial"/>
            </StackPanel>

          </Grid>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Page>
