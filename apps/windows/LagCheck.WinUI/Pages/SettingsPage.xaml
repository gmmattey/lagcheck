<Page x:Class="LagCheck.WinUI.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource DeepBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,40">
    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Padding="40,32,40,48" Spacing="20">
      
      <!-- Cabeçalho da Página -->
      <StackPanel Spacing="4" Margin="0,0,0,8">
        <TextBlock Text="SISTEMA · CONFIGURAÇÕES" Style="{StaticResource EyebrowTextStyle}" Foreground="{StaticResource PurpleLightBrush}"/>
        <TextBlock Text="Ajustes do Launcher" Style="{StaticResource PageTitleStyle}"/>
        <TextBlock Text="Controle o comportamento da interface e diagnósticos de rede neste PC." Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
        
        <Border Background="#1C212B" CornerRadius="8" Padding="12,6" HorizontalAlignment="Left" Margin="0,8,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="6" Height="6" Fill="{StaticResource ReadyBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="ConnectionStatus" Text="Conectando aos ajustes locais…" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Card 1: Interface e Visual -->
      <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="24,20">
        <StackPanel Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon Glyph="&#xE790;" FontSize="18" Foreground="{StaticResource PurpleLightBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="Interface e Visual" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>

          <!-- Reduzir Movimento -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3" Margin="0,0,16,0">
              <TextBlock Text="Reduzir movimento" FontWeight="SemiBold" FontSize="14"/>
              <TextBlock Text="Desativa animações e transições visuais para resposta imediata." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap"/>
            </StackPanel>
            <ToggleSwitch x:Name="ReduceMotionSwitch" Grid.Column="1" IsEnabled="False" Toggled="Preference_Toggled" Tag="reduceMotion" OffContent="" OnContent="" VerticalAlignment="Center"/>
          </Grid>

          <Border Background="{StaticResource LineBrush}" Height="1"/>

          <!-- Baixar Imagens dos Jogos -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3" Margin="0,0,16,0">
              <TextBlock Text="Baixar imagens dos jogos" FontWeight="SemiBold" FontSize="14"/>
              <TextBlock Text="Carrega capas e banners oficiais do cache local dos seus launchers. Desligado, usa miniaturas neutras." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap"/>
            </StackPanel>
            <ToggleSwitch x:Name="ArtworkSwitch" Grid.Column="1" IsEnabled="False" Toggled="Preference_Toggled" Tag="artworkDownload" OffContent="" OnContent="" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Card 2: Diagnóstico e Privacidade de Rede -->
      <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="24,20">
        <StackPanel Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon Glyph="&#xE72D;" FontSize="18" Foreground="{StaticResource PurpleLightBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="Privacidade e Rede" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>

          <!-- Localização Aproximada -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3" Margin="0,0,16,0">
              <TextBlock Text="Localização aproximada" FontWeight="SemiBold" FontSize="14"/>
              <TextBlock Text="Usa a cidade estimada pelo IP para traçar a rota geográfica. Nunca utiliza GPS." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap"/>
            </StackPanel>
            <ToggleSwitch x:Name="ApproximateLocationSwitch" Grid.Column="1" IsEnabled="False" Toggled="Preference_Toggled" Tag="approximateLocation" OffContent="" OnContent="" VerticalAlignment="Center"/>
          </Grid>

          <Border Background="{StaticResource LineBrush}" Height="1"/>

          <!-- Enviar Dados Anônimos -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3" Margin="0,0,16,0">
              <TextBlock Text="Enviar estatísticas anônimas" FontWeight="SemiBold" FontSize="14"/>
              <TextBlock Text="Apenas veredito e rota da partida. Sem endereço IP, nome de rede ou identificador pessoal." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap"/>
            </StackPanel>
            <ToggleSwitch x:Name="AnalyticsSwitch" Grid.Column="1" IsEnabled="False" Toggled="Preference_Toggled" Tag="analytics" OffContent="" OnContent="" VerticalAlignment="Center"/>
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,4,0,0">
            <Button x:Name="RenewAnalyticsIdButton" Content="Gerar novo ID local" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" Click="RenewAnalyticsId_Click"/>
            <TextBlock x:Name="AnalyticsStatus" Foreground="{StaticResource TextTertiaryBrush}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Card 3: Atualizações do Launcher -->
      <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="24,20">
        <StackPanel Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon Glyph="&#xE896;" FontSize="18" Foreground="{StaticResource PurpleLightBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="Atualizações" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>

          <!-- Verificar Automaticamente -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3" Margin="0,0,16,0">
              <TextBlock Text="Verificar automaticamente" FontWeight="SemiBold" FontSize="14"/>
              <TextBlock Text="Consulta periodicamente por novas versões no canal oficial do GitHub." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap"/>
            </StackPanel>
            <ToggleSwitch x:Name="AutomaticUpdatesSwitch" Grid.Column="1" IsEnabled="False" Toggled="Preference_Toggled" Tag="automaticUpdates" OffContent="" OnContent="" VerticalAlignment="Center"/>
          </Grid>

          <Border Background="{StaticResource LineBrush}" Height="1"/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="UpdateStatus" Text="Conectando ao atualizador local…" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button x:Name="CheckUpdatesButton" Grid.Column="1" Content="Verificar agora" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" Click="CheckUpdates_Click"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Card 4: Sobre o Produto -->
      <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="24,20">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon Glyph="&#xE946;" FontSize="18" Foreground="{StaticResource PurpleLightBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="Sobre o LagCheck" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="LagCheck para Windows — Launcher gamer com pre-flight check de rede integrado. Sem conta obrigatória e sem anúncios." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap"/>
          <TextBlock Text="Versão v0.1.0 · WinUI 3 (x64) · Repositório Oficial" FontFamily="{StaticResource TechnicalFont}" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Page>
