<Page x:Class="LagCheck.WinUI.Pages.HomePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ctl="using:LagCheck.WinUI.Controls" xmlns:wd="using:LagCheck.WinUI.Widgets" xmlns:automation="using:Microsoft.UI.Xaml.Automation" NavigationCacheMode="Required" Background="Transparent" Loaded="HomePage_Loaded" Unloaded="HomePage_Unloaded" SizeChanged="HomePage_SizeChanged">
  <Page.Resources>
    <Style x:Key="HomeWidgetStyle" TargetType="Border">
      <Setter Property="Background" Value="#E615181E"/>
      <Setter Property="BorderBrush" Value="{StaticResource SurfaceDepthBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="HomeWidgetTitleStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource BodySemiBoldFont}"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Page.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid x:Name="Stage" Padding="24,12,24,20" RowSpacing="14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" RowSpacing="8">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="180"/></Grid.RowDefinitions>
      <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
          <Button x:Name="TopLibraryBtn" Style="{StaticResource CircleIconButtonStyle}" Width="44" Height="44" CornerRadius="10" Click="OpenLibrary_Click" automation:AutomationProperties.Name="Biblioteca"><ctl:SvgIcon Data="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z" Size="16"/></Button>
          <Button x:Name="TopHistoryBtn" Style="{StaticResource CircleIconButtonStyle}" Width="44" Height="44" CornerRadius="10" Click="OpenHistory_Click" automation:AutomationProperties.Name="Histórico"><ctl:SvgIcon Data="M12 7v5l3 2M3 12a9 9 0 1 0 3-6.7M3 4v5h5" Size="16"/></Button>
          <Button x:Name="TopGalleryBtn" Style="{StaticResource CircleIconButtonStyle}" Width="44" Height="44" CornerRadius="10" Click="OpenGallery_Click" automation:AutomationProperties.Name="Galeria"><ctl:SvgIcon Data="M4 5h16v14H4zM7 15l3-3 2 2 3-4 3 5M8 9h.01" Size="16"/></Button>
          <Button x:Name="TopSearchBtn" Style="{StaticResource CircleIconButtonStyle}" Width="44" Height="44" CornerRadius="10" Click="OpenSearch_Click" automation:AutomationProperties.Name="Buscar jogo"><ctl:SvgIcon Data="M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM21 21l-5-5" Size="16"/></Button>
          <Button x:Name="TopSettingsBtn" Style="{StaticResource CircleIconButtonStyle}" Width="44" Height="44" CornerRadius="10" Click="OpenSettings_Click" automation:AutomationProperties.Name="Ajustes"><FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}"/></Button>
        </StackPanel>
      </Grid>
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" Margin="-18,-14,-18,0" Padding="0"><StackPanel x:Name="RecentsPanel" Orientation="Horizontal" Spacing="10" Padding="18,14,18,18"/></ScrollViewer>
    </Grid>
    <Grid x:Name="HomeContentGrid" Grid.Row="1" ColumnSpacing="14"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
      <!-- Hero sem camada visual: texto e ações voltam ao canto inferior esquerdo da arte original. -->
      <Border x:Name="HeroSurface" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,24" MaxWidth="620">
        <Grid>
          <StackPanel x:Name="GameHeroPanel" Spacing="12" VerticalAlignment="Center">
            <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
              <Rectangle x:Name="PlatformPillShadow" RadiusX="8" RadiusY="8" Fill="#FF0B0D10" IsHitTestVisible="False"/>
              <Border x:Name="PlatformPill" Background="{StaticResource SurfaceElevatedBrush}" BorderBrush="{StaticResource SurfaceDepthBorderBrush}" BorderThickness="1" CornerRadius="8" Height="32" Padding="12,0" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><ctl:SvgIcon x:Name="PlatformLogo" FillOnly="True" Size="18" Foreground="{StaticResource TextPrimaryBrush}"/><ctl:SvgIcon x:Name="PlatformMonitor" Data="M5 4h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM8 20h8M12 16v4" Size="16" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock x:Name="PlatformText" Text="PC" FontFamily="{StaticResource BodySemiBoldFont}" FontWeight="Normal" FontSize="13" VerticalAlignment="Center"/></StackPanel></Border>
            </Grid>
            <Image x:Name="GameLogoImage" MaxHeight="84" MaxWidth="340" Stretch="Uniform" HorizontalAlignment="Left" Visibility="Collapsed"/>
            <TextBlock x:Name="GameTitleText" Style="{StaticResource DisplayTitleStyle}" FontSize="54" LineHeight="53" LineStackingStrategy="BlockLineHeight" CharacterSpacing="-10" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
            <Border x:Name="GamePillsHost" HorizontalAlignment="Left"/>
            <StackPanel x:Name="HeroVerdictPanel" Orientation="Horizontal" Spacing="14" Visibility="Collapsed"><Border x:Name="VerdictBorder" CornerRadius="8" Padding="12,6" BorderThickness="1" BorderBrush="#4D22C55E" Background="#2922C55E"><TextBlock x:Name="VerdictText" FontFamily="{StaticResource HeadingBoldFont}" FontWeight="Normal" FontSize="13" CharacterSpacing="25" Foreground="{StaticResource ReadyBrush}"/></Border><TextBlock x:Name="PingEstimateText" Style="{StaticResource MetricTextStyle}" FontSize="22" VerticalAlignment="Center"/></StackPanel>
            <StackPanel x:Name="HeroActions" Spacing="8" Margin="0,4,0,0">
              <Border x:Name="LaunchCtaRing" BorderBrush="{StaticResource HomeHeroCtaRingBrush}" BorderThickness="1" CornerRadius="16" Padding="4" UseLayoutRounding="True" HorizontalAlignment="Left"><Grid><Rectangle x:Name="LaunchGlow" RadiusX="12" RadiusY="12" Fill="{StaticResource PurpleBrush}"/><Button x:Name="LaunchBtn" Style="{StaticResource HomeHeroCtaButtonStyle}" MinWidth="232" Click="Launch_Click" automation:AutomationProperties.Name="Jogar agora"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBlock x:Name="LaunchBtnText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource BodySemiBoldFont}" FontWeight="Normal" FontSize="14" CharacterSpacing="25" Foreground="White"/><Grid Grid.Column="2" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"><Border CornerRadius="8" Background="White"/><FontIcon Glyph="&#xE72A;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{StaticResource PurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Grid></Button></Grid></Border>
              <Grid x:Name="CheckConnContainer" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Rectangle x:Name="CheckConnShadow" RadiusX="12" RadiusY="12" Fill="#FF0B0D10" IsHitTestVisible="False"/>
                <Button x:Name="CheckConnBtn" Style="{StaticResource GhostPillButtonStyle}" Content="Testar conexão" Click="CheckConnection_Click" automation:AutomationProperties.Name="Testar conexão"/>
              </Grid>
              <Grid x:Name="DetailsBtnContainer" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Rectangle x:Name="DetailsBtnShadow" RadiusX="12" RadiusY="12" Fill="#FF0B0D10" IsHitTestVisible="False"/>
                <Button x:Name="DetailsBtn" Style="{StaticResource CircleIconButtonStyle}" Click="OpenDetails_Click" automation:AutomationProperties.Name="Detalhes do jogo"><ctl:SvgIcon Data="M12 8h.01M11 12h1v5h1M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z" Size="18" Foreground="{StaticResource TextPrimaryBrush}"/></Button>
              </Grid>
              <Grid x:Name="FavBtnContainer" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Rectangle x:Name="FavBtnShadow" RadiusX="12" RadiusY="12" Fill="#FF0B0D10" IsHitTestVisible="False"/>
                <Button x:Name="FavBtn" Style="{StaticResource CircleIconButtonStyle}" Click="ToggleFavorite_Click" automation:AutomationProperties.Name="Favoritar jogo"><ctl:SvgIcon x:Name="FavIcon" Data="M12 21s-7-4.6-9.3-9A5.3 5.3 0 0 1 12 6.6 5.3 5.3 0 0 1 21.3 12C19 16.4 12 21 12 21z" Size="18" Foreground="{StaticResource TextPrimaryBrush}"/></Button>
              </Grid>
            </StackPanel>
          </StackPanel>
          <StackPanel x:Name="PcHeroPanel" Spacing="12" Visibility="Collapsed" VerticalAlignment="Center">
            <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
              <Rectangle x:Name="PcPlatformPillShadow" RadiusX="8" RadiusY="8" Fill="#FF0B0D10" IsHitTestVisible="False"/>
              <Border Background="{StaticResource SurfaceElevatedBrush}" BorderBrush="{StaticResource SurfaceDepthBorderBrush}" BorderThickness="1" CornerRadius="8" Height="32" Padding="12,0" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><ctl:SvgIcon Data="M5 4h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM8 20h8M12 16v4" Size="16" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock x:Name="PcPlatformText" Text="ESTE PC" FontFamily="{StaticResource BodySemiBoldFont}" FontWeight="Normal" FontSize="13" VerticalAlignment="Center"/></StackPanel></Border>
            </Grid>
            <TextBlock x:Name="PcHeroTitle" Text="SEU PC" Style="{StaticResource DisplayTitleStyle}" FontSize="54" LineHeight="53" LineStackingStrategy="BlockLineHeight" CharacterSpacing="-10" TextWrapping="Wrap"/>
            <TextBlock x:Name="PcHeroDescription" Foreground="{StaticResource TextSecondaryBrush}" FontSize="15" TextWrapping="Wrap"/>
            <StackPanel Spacing="8" Margin="0,4,0,0"><Button x:Name="PcCheckBtn" Style="{StaticResource HeroPrimaryButtonStyle}" Content="Testar conexão geral" Click="GeneralCheck_Click" automation:AutomationProperties.Name="Testar conexão geral"/></StackPanel>
          </StackPanel>
          <StackPanel x:Name="EmptyHeroPanel" Spacing="16" Visibility="Collapsed" VerticalAlignment="Center"><TextBlock x:Name="CockpitEyebrow" Text="COCKPIT DE TELEMETRIA" Foreground="{StaticResource PurpleLightBrush}" FontFamily="{StaticResource TechnicalFont}" FontWeight="Normal" FontSize="12" CharacterSpacing="70"/><TextBlock x:Name="EmptyHeroTitle" Text="NENHUM JOGO LOCAL ENCONTRADO" Style="{StaticResource DisplayTitleStyle}" FontSize="42" LineHeight="42" TextWrapping="Wrap"/><TextBlock x:Name="EmptyHeroDesc" Foreground="{StaticResource TextSecondaryBrush}" FontSize="15" TextWrapping="Wrap"/><StackPanel Spacing="8"><Button x:Name="ScanGamesBtn" Style="{StaticResource PillPrimaryButtonStyle}" Content="Procurar jogos instalados" Click="Rescan_Click"/><Button x:Name="GeneralCheckBtn" Style="{StaticResource GhostPillButtonStyle}" Content="Testar conexão geral" Click="GeneralCheck_Click"/></StackPanel></StackPanel>
        </Grid>
      </Border>
      <ScrollViewer x:Name="InsightsScroll" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" MaxHeight="620" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><wd:WidgetHost x:Name="Widgets"/></ScrollViewer>
    </Grid>
  </Grid></ScrollViewer>
</Page>
