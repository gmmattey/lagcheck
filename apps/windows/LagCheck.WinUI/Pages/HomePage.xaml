<Page
    x:Class="LagCheck.WinUI.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:LagCheck.WinUI.Controls"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    NavigationCacheMode="Required"
    Background="Transparent"
    Loaded="HomePage_Loaded"
    Unloaded="HomePage_Unloaded"
    SizeChanged="HomePage_SizeChanged">

    <!-- A arte (slides + gradientes) vive no shell, atrás da janela inteira; aqui só o conteúdo do palco -->
    <Grid x:Name="Stage" Padding="48,0,48,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Hero do jogo em destaque -->
        <StackPanel x:Name="GameHeroPanel" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Left" MaxWidth="640" Spacing="18" Margin="0,0,0,30">
            <!-- Plataforma -->
            <Border x:Name="PlatformPill" Background="#D9282E3C" CornerRadius="14" Height="34" Padding="14,0" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ctl:SvgIcon x:Name="PlatformLogo" FillOnly="True" Size="18" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <ctl:SvgIcon x:Name="PlatformMonitor" Data="M5 4h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM8 20h8M12 16v4" Size="16" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PlatformText" Text="PC" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="GameTitleText" Style="{StaticResource DisplayTitleStyle}" FontSize="64" LineHeight="62" LineStackingStrategy="BlockLineHeight"
                       CharacterSpacing="-10" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>

            <!-- Veredito da última medição real deste jogo -->
            <StackPanel x:Name="HeroVerdictPanel" Orientation="Horizontal" Spacing="14" Visibility="Collapsed">
                <Border x:Name="VerdictBorder" CornerRadius="14" Padding="16,7" Background="#2922C55E">
                    <TextBlock x:Name="VerdictText" FontWeight="Bold" FontSize="13" CharacterSpacing="25" Foreground="{StaticResource ReadyBrush}"/>
                </Border>
                <TextBlock x:Name="PingEstimateText" Style="{StaticResource MetricTextStyle}" FontSize="22" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Ações -->
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
                <Grid>
                    <Rectangle x:Name="LaunchGlow" RadiusX="28" RadiusY="28" Fill="{StaticResource PurpleBrush}"/>
                    <Button x:Name="LaunchBtn" Style="{StaticResource PillPrimaryButtonStyle}" Content="▶ JOGAR AGORA" Click="Launch_Click"
                            automation:AutomationProperties.Name="Jogar agora"/>
                </Grid>
                <Button x:Name="CheckConnBtn" Style="{StaticResource GhostPillButtonStyle}" Content="Checar conexão" Click="CheckConnection_Click"
                        automation:AutomationProperties.Name="Checar conexão"/>
                <Button x:Name="FavBtn" Style="{StaticResource CircleIconButtonStyle}" Click="ToggleFavorite_Click" automation:AutomationProperties.Name="Favoritar jogo">
                    <ctl:SvgIcon x:Name="FavIcon" Data="M12 21s-7-4.6-9.3-9A5.3 5.3 0 0 1 12 6.6 5.3 5.3 0 0 1 21.3 12C19 16.4 12 21 12 21z" Size="18" Foreground="{StaticResource TextPrimaryBrush}"/>
                </Button>
                <Button x:Name="RefreshArtBtn" Style="{StaticResource CircleIconButtonStyle}" Click="RefreshArtwork_Click" automation:AutomationProperties.Name="Atualizar imagem">
                    <ctl:SvgIcon Data="M20 12a8 8 0 1 1-2.3-5.7M20 4v5h-5" Size="18" Foreground="{StaticResource TextPrimaryBrush}"/>
                </Button>
            </StackPanel>

            <!-- Indicadores de slide -->
            <StackPanel x:Name="DotsPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Estado vazio: nenhum jogo instalado encontrado -->
        <StackPanel x:Name="EmptyHeroPanel" Grid.Row="0" Spacing="16" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Left" MaxWidth="640" Margin="0,0,0,30">
            <Border Background="#257C3AED" CornerRadius="14" Height="34" Padding="14,0" HorizontalAlignment="Left">
                <TextBlock x:Name="CockpitEyebrow" Text="COCKPIT DE TELEMETRIA" Foreground="{StaticResource PurpleLightBrush}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="EmptyHeroTitle" Text="NENHUM JOGO LOCAL ENCONTRADO" Style="{StaticResource DisplayTitleStyle}"
                       FontSize="56" LineHeight="56" LineStackingStrategy="BlockLineHeight" CharacterSpacing="-10" TextWrapping="Wrap"/>
            <TextBlock x:Name="EmptyHeroDesc" Text="O LagCheck monitora seus jogos instalados (Steam, Epic, Xbox) ou sua rota geral."
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="15" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                <Button x:Name="ScanGamesBtn" Style="{StaticResource PillPrimaryButtonStyle}" Height="50" Padding="32,0" CornerRadius="25" FontSize="14"
                        Content="Procurar jogos instalados" Click="Rescan_Click"/>
                <Button x:Name="GeneralCheckBtn" Style="{StaticResource GhostPillButtonStyle}" Height="50" CornerRadius="25"
                        Content="Testar conexão geral" Click="GeneralCheck_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Faixa de recentes -->
        <ScrollViewer x:Name="RecentsScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
            <StackPanel x:Name="RecentsPanel" Orientation="Horizontal" Spacing="14" VerticalAlignment="Bottom" Padding="0,6,4,6"/>
        </ScrollViewer>
    </Grid>
</Page>
