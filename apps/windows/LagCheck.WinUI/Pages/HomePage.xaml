<Page
    x:Class="LagCheck.WinUI.Pages.HomePage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LagCheck.WinUI.Library"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    Background="Transparent"
    Loaded="HomePage_Loaded">

    <Page.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <!-- Background Cinematográfico em Tela Cheia -->
        <Grid x:Name="BackgroundStage">
            <Image x:Name="HeroBackgroundImage" Stretch="UniformToFill" Opacity="0.55" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <!-- Gradiente horizontal escuro da esquerda para a direita -->
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#F00B0D12" Offset="0.0" />
                        <GradientStop Color="#C00B0D12" Offset="0.45" />
                        <GradientStop Color="#200B0D12" Offset="1.0" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- Gradiente vertical suave -->
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#800B0D12" Offset="0.0" />
                        <GradientStop Color="Transparent" Offset="0.25" />
                        <GradientStop Color="Transparent" Offset="0.60" />
                        <GradientStop Color="#E80B0D12" Offset="1.0" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- Conteúdo do Palco do Início -->
        <Grid Padding="48,0,48,24" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Seção do Jogo em Destaque (Hero) -->
            <StackPanel Grid.Row="0" VerticalAlignment="Bottom" MaxWidth="720" HorizontalAlignment="Left" Spacing="14" Margin="0,0,0,24">
                
                <!-- Estado Com Jogo -->
                <StackPanel x:Name="GameHeroPanel" Spacing="14">
                    <!-- Badge da Plataforma -->
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Background="#D0282E3C" CornerRadius="14" Padding="14,7">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7FC;" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock x:Name="PlatformText" Text="{Binding HeroGame.PlatformLabel}" Style="{StaticResource EyebrowTextStyle}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Título do Jogo em Barlow Semi Condensed 72px maiúsculo -->
                    <TextBlock x:Name="GameTitleText" Text="{Binding HeroGame.Title}"
                               FontFamily="{StaticResource HeadingFont}" FontWeight="ExtraBold"
                               FontSize="56" LineHeight="58"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap" />

                    <!-- Tag de Veredito Pré-Partida / Conexão -->
                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center" Margin="0,2,0,0">
                        <Border Background="#2522C55E" CornerRadius="14" Padding="16,7">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource ReadyBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="VerdictText" Text="● PRONTO PARA RANKED" Foreground="{StaticResource ReadyBrush}" FontWeight="Bold" FontSize="13" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="PingEstimateText" Text="12 ms" FontFamily="{StaticResource MetricFont}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Ações Principais do Jogo -->
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,10,0,0" VerticalAlignment="Center">
                        <!-- Botão JOGAR AGORA com Glow Roxo -->
                        <Button x:Name="LaunchBtn" Content="▶ JOGAR AGORA"
                                Height="56" Padding="42,0" CornerRadius="28"
                                Background="{StaticResource PurpleBrush}" Foreground="White"
                                FontSize="16" FontWeight="Bold" BorderThickness="0"
                                Click="Launch_Click"
                                ToolTipService.ToolTip="Iniciar jogo instalado" automation:AutomationProperties.Name="Jogar agora" />

                        <!-- Botão Checar Conexão -->
                        <Button x:Name="CheckConnBtn" Content="Checar conexão"
                                Height="56" Padding="28,0" CornerRadius="28"
                                Background="#D0252A36" Foreground="{StaticResource TextPrimaryBrush}"
                                FontSize="14" FontWeight="SemiBold" BorderThickness="0"
                                Click="CheckConnection_Click"
                                ToolTipService.ToolTip="Avaliar rota e estabilidade pré-partida" automation:AutomationProperties.Name="Checar conexão" />

                        <!-- Botão Favoritar -->
                        <Button x:Name="FavBtn" Width="46" Height="46" CornerRadius="23"
                                Background="#D0252A36" BorderThickness="0"
                                Click="ToggleFavorite_Click"
                                ToolTipService.ToolTip="Favoritar jogo" automation:AutomationProperties.Name="Favoritar jogo">
                            <FontIcon Glyph="&#xE734;" FontSize="18" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Button>

                        <!-- Botão Atualizar Imagem -->
                        <Button x:Name="RefreshArtBtn" Width="46" Height="46" CornerRadius="23"
                                Background="#D0252A36" BorderThickness="0"
                                Click="RefreshArtwork_Click"
                                ToolTipService.ToolTip="Atualizar imagem oficial" automation:AutomationProperties.Name="Atualizar imagem">
                            <FontIcon Glyph="&#xE72C;" FontSize="18" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Estado Vazio (Sem Jogos Instalados) -->
                <StackPanel x:Name="EmptyHeroPanel" Spacing="16" Visibility="Collapsed">
                    <Border Background="#257C3AED" CornerRadius="14" Padding="14,7" HorizontalAlignment="Left">
                        <TextBlock x:Name="CockpitEyebrow" Text="COCKPIT DE TELEMETRIA" Foreground="{StaticResource PurpleLightBrush}" FontWeight="Bold" FontSize="13" />
                    </Border>
                    <TextBlock x:Name="EmptyHeroTitle" Text="NENHUM JOGO LOCAL ENCONTRADO"
                               FontFamily="{StaticResource HeadingFont}" FontWeight="ExtraBold"
                               FontSize="48" LineHeight="52"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock x:Name="EmptyHeroDesc" Text="O LagCheck monitora seus jogos instalados (Steam, Epic, Xbox) ou sua rota geral."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="15" />
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                        <Button x:Name="ScanGamesBtn" Content="Procurar jogos instalados" Height="50" Padding="32,0" CornerRadius="25"
                                Background="{StaticResource PurpleBrush}" Foreground="White" FontWeight="Bold"
                                Click="Rescan_Click" />
                        <Button x:Name="GeneralCheckBtn" Content="Testar conexão geral" Height="50" Padding="28,0" CornerRadius="25"
                                Background="#D0252A36" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"
                                Click="GeneralCheck_Click" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Faixa Horizontal de Jogos Recentes na Base -->
            <StackPanel Grid.Row="1" Spacing="8">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled">
                    <ItemsControl x:Name="RecentGamesList" ItemsSource="{Binding VisibleGames}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="14" Padding="4,6,4,6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:LibraryGame">
                                <Button Click="RecentGame_Click" Padding="0" BorderThickness="0" Background="Transparent"
                                        CornerRadius="14" Width="110" Height="165"
                                        ToolTipService.ToolTip="{Binding Title}">
                                    <Border CornerRadius="14" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                        <Grid>
                                            <Image Source="{Binding CoverArtworkPath}" Stretch="UniformToFill" />
                                            <Rectangle Fill="{StaticResource SurfaceBrush}" Opacity="0.4" />
                                            <Border VerticalAlignment="Bottom" Padding="8,6" Background="#C00D0F14">
                                                <TextBlock Text="{Binding Title}" FontFamily="{StaticResource HeadingFont}" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
