<Page x:Class="LagCheck.WinUI.Pages.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:LagCheck.WinUI.Pages"
      Background="Transparent">
  <Grid RowSpacing="22" Padding="38,32,38,48">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="TitleText" Text="Histórico de Sessões" Style="{StaticResource PageTitleStyle}"/>

    <TextBox x:Name="SearchBox" Grid.Row="1" PlaceholderText="Buscar por região ou veredito" TextChanged="SearchBox_TextChanged" Height="44" CornerRadius="12"/>

    <Grid Grid.Row="2">
      <ScrollViewer x:Name="HistoryScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <ItemsRepeater x:Name="HistoryList">
          <ItemsRepeater.Layout>
            <StackLayout Orientation="Vertical" Spacing="0"/>
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="local:HistoryRow">
              <Grid BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="0,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="100"/>
                  <ColumnDefinition Width="100"/>
                  <ColumnDefinition Width="100"/>
                  <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{x:Bind Verdict}" FontSize="18" FontWeight="Bold"/>
                  <TextBlock Text="{x:Bind Region}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind Ping}" Style="{StaticResource MetricTextStyle}" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{x:Bind Jitter}" Style="{StaticResource MetricTextStyle}" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{x:Bind Loss}" Style="{StaticResource MetricTextStyle}" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="{x:Bind Time}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </ScrollViewer>

      <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520" Spacing="12">
        <TextBlock x:Name="EmptyTitle" Text="Sem testes nesta sessão" Style="{StaticResource PageTitleStyle}" TextAlignment="Center"/>
      </StackPanel>

      <TextBlock x:Name="NoResults" Text="Nenhuma medição corresponde à busca." Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
    </Grid>
  </Grid>
</Page>
