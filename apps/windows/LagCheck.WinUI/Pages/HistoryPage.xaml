<Page x:Class="LagCheck.WinUI.Pages.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:LagCheck.WinUI.Pages"
      Background="Transparent">
  <Grid RowSpacing="16" Padding="{StaticResource PagePadding}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="TitleText" Text="HISTÓRICO" Style="{StaticResource PageHeaderStyle}"/>

    <StackPanel Grid.Row="1" Spacing="8">
      <ScrollViewer x:Name="ScopeChipsScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel x:Name="ScopeChips" Orientation="Horizontal" Spacing="8"/>
      </ScrollViewer>
      <ScrollViewer x:Name="WindowChipsScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel x:Name="WindowChips" Orientation="Horizontal" Spacing="8"/>
      </ScrollViewer>
      <ScrollViewer x:Name="NetworkChipsScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Visibility="Collapsed">
        <StackPanel x:Name="NetworkChips" Orientation="Horizontal" Spacing="8"/>
      </ScrollViewer>
    </StackPanel>

    <Border x:Name="StabilityCard" Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20,18" Visibility="Collapsed">
      <Grid ColumnSpacing="20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Spacing="10">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse x:Name="StabilityDot" Width="8" Height="8" VerticalAlignment="Center"/>
                <TextBlock x:Name="StabilityTitle" Style="{StaticResource TechLabelStyle}" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock x:Name="StabilityHeadline" FontFamily="{StaticResource HeadingBoldFont}" FontSize="22" FontWeight="Normal" Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
              <TextBlock x:Name="StabilityPercent" Style="{StaticResource MetricTextStyle}" FontSize="24" HorizontalAlignment="Right"/>
              <TextBlock x:Name="StabilitySubtitle" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
            </StackPanel>
          </Grid>

          <Border x:Name="StabilityChartHost" Height="120"/>
          <TextBlock x:Name="StabilityHint" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed"/>
        </StackPanel>

        <Border x:Name="StabilityDivider" Grid.Column="1" Width="1" Background="#1FFFFFFF" Margin="0,4"/>

        <StackPanel x:Name="StabilityGaugesHost" Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <TextBox x:Name="SearchBox" Grid.Row="3" PlaceholderText="Buscar por região ou veredito" TextChanged="SearchBox_TextChanged" Height="44" CornerRadius="12"/>

    <Grid Grid.Row="4" RowSpacing="0">
      <Border x:Name="TableCard" Padding="0" Visibility="Collapsed">
        <Grid RowSpacing="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Grid x:Name="HeaderRow" ColumnSpacing="16" Padding="8,12,8,10" BorderBrush="#17FFFFFF" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.4*"/>
              <ColumnDefinition Width="1*"/>
              <ColumnDefinition Width="1.3*"/>
              <ColumnDefinition Width="92"/>
              <ColumnDefinition Width="92"/>
              <ColumnDefinition Width="80"/>
              <ColumnDefinition Width="72"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HGame" Text="JOGO" Style="{StaticResource TechLabelStyle}"/>
            <TextBlock x:Name="HRegion" Grid.Column="1" Text="REGIÃO" Style="{StaticResource TechLabelStyle}"/>
            <TextBlock x:Name="HResult" Grid.Column="2" Text="RESULTADO" Style="{StaticResource TechLabelStyle}"/>
            <TextBlock Grid.Column="3" Text="PING" Style="{StaticResource TechLabelStyle}" HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="4" Text="JITTER" Style="{StaticResource TechLabelStyle}" HorizontalAlignment="Right"/>
            <TextBlock x:Name="HLoss" Grid.Column="5" Text="PERDA" Style="{StaticResource TechLabelStyle}" HorizontalAlignment="Right"/>
            <TextBlock x:Name="HTime" Grid.Column="6" Text="HORA" Style="{StaticResource TechLabelStyle}" HorizontalAlignment="Right"/>
          </Grid>

          <ScrollViewer x:Name="HistoryScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsRepeater x:Name="HistoryList" ElementPrepared="HistoryList_ElementPrepared" ElementClearing="HistoryList_ElementClearing">
              <ItemsRepeater.Layout>
                <StackLayout Orientation="Vertical" Spacing="0"/>
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="local:HistoryRow">
                  <Grid Background="Transparent" BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="8,14" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="1.4*"/>
                      <ColumnDefinition Width="1*"/>
                      <ColumnDefinition Width="1.3*"/>
                      <ColumnDefinition Width="92"/>
                      <ColumnDefinition Width="92"/>
                      <ColumnDefinition Width="80"/>
                      <ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Game}" FontFamily="{StaticResource HeadingBoldFont}" FontWeight="Normal" FontSize="16" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind Region}" FontFamily="{StaticResource BodySemiBoldFont}" FontWeight="Normal" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                      <Ellipse Width="9" Height="9" Fill="{x:Bind ToneBrush}" VerticalAlignment="Center"/>
                      <TextBlock Text="{x:Bind Verdict}" FontFamily="{StaticResource HeadingBoldFont}" FontWeight="Normal" FontSize="14" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{x:Bind Ping}" Style="{StaticResource MetricTextStyle}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="{x:Bind Jitter}" Style="{StaticResource MetricTextStyle}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="{x:Bind Loss}" Style="{StaticResource MetricTextStyle}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="6" Text="{x:Bind Time}" FontFamily="{StaticResource TechnicalFont}" FontWeight="Normal" FontSize="13" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  </Grid>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
          </ScrollViewer>
        </Grid>
      </Border>

      <StackPanel x:Name="EmptyState" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520" Spacing="14">
        <TextBlock x:Name="EmptyTitle" Text="Sem testes ainda" Style="{StaticResource PageTitleStyle}" TextAlignment="Center"/>
        <TextBlock x:Name="EmptyDescription" Text="Teste sua conexão para ver aqui o histórico das medições." Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap"/>
        <Button x:Name="StartCheckButton" Style="{StaticResource PillPrimaryButtonStyle}" Content="Testar conexão" HorizontalAlignment="Center" Margin="0,8,0,0" Click="StartCheck_Click"/>
      </StackPanel>

      <TextBlock x:Name="NoResults" Grid.RowSpan="2" Text="Nenhuma medição corresponde à busca." Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
    </Grid>
  </Grid>
</Page>
