<Page x:Class="LagCheck.WinUI.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource DeepBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="680" Padding="38,32,38,48" Spacing="4">
      <TextBlock Text="PREFERÊNCIAS" Foreground="{StaticResource PurpleLightBrush}" Style="{StaticResource EyebrowTextStyle}"/>
      <TextBlock Text="Ajustes do Launcher" Style="{StaticResource PageTitleStyle}"/>
      <TextBlock Text="Controle como o launcher e os diagnósticos se comportam neste PC." Foreground="{StaticResource TextSecondaryBrush}" FontSize="15" Margin="0,2,0,4"/>
      <TextBlock x:Name="ConnectionStatus" Text="Conectando aos ajustes locais…" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,24"/>

      <!-- Preferências de Interface -->
      <Grid Padding="0,12,0,18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="3">
          <TextBlock Text="Reduzir movimento" FontWeight="SemiBold" FontSize="15"/>
          <TextBlock Text="Para transições e animações da interface." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <ToggleSwitch x:Name="ReduceMotionSwitch" Grid.Column="1" IsEnabled="False" Toggled="Preference_Toggled" Tag="reduceMotion" OffContent="" OnContent=""/>
      </Grid>
      
      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"/>
      
      <!-- Imagens dos Jogos -->
      <Grid Padding="0,18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="3">
          <TextBlock Text="Baixar imagens dos jogos" FontWeight="SemiBold" FontSize="15"/>
          <TextBlock Text="Capas e banners oficiais do cache local. Desligado, usa miniaturas neutras do LagCheck." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <ToggleSwitch x:Name="ArtworkSwitch" Grid.Column="1" IsEnabled="False" Toggled="Preference_Toggled" Tag="artworkDownload" OffContent="" OnContent=""/>
      </Grid>
      
      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"/>
      
      <!-- Localização Aproximada -->
      <Grid Padding="0,18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="3">
          <TextBlock Text="Localização aproximada" FontWeight="SemiBold" FontSize="15"/>
          <TextBlock Text="Cidade aproximada pelo IP para posicionar o trajeto da rota. Nunca GPS." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <ToggleSwitch x:Name="ApproximateLocationSwitch" Grid.Column="1" IsEnabled="False" Toggled="Preference_Toggled" Tag="approximateLocation" OffContent="" OnContent=""/>
      </Grid>
      
      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"/>
      
      <!-- Dados Anônimos -->
      <StackPanel Padding="0,18" Spacing="12">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Spacing="3">
            <TextBlock Text="Enviar dados de uso anônimos" FontWeight="SemiBold" FontSize="15"/>
            <TextBlock Text="Jogo, veredito e duração da medição. Sem IP, nome da rede ou identificadores pessoais." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
          </StackPanel>
          <ToggleSwitch x:Name="AnalyticsSwitch" Grid.Column="1" IsEnabled="False" Toggled="Preference_Toggled" Tag="analytics" OffContent="" OnContent=""/>
        </Grid>
        <Button x:Name="RenewAnalyticsIdButton" Content="GERAR NOVO ID" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" HorizontalAlignment="Left" Click="RenewAnalyticsId_Click"/>
        <TextBlock x:Name="AnalyticsStatus" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="13"/>
      </StackPanel>
      
      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"/>
      
      <!-- Atualizações -->
      <StackPanel Padding="0,18" Spacing="10">
        <TextBlock Text="ATUALIZAÇÕES" Style="{StaticResource EyebrowTextStyle}"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Spacing="3">
            <TextBlock Text="Verificar automaticamente" FontWeight="SemiBold" FontSize="15"/>
            <TextBlock Text="Usa somente a fonte segura de releases deste repositório." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
          </StackPanel>
          <ToggleSwitch x:Name="AutomaticUpdatesSwitch" Grid.Column="1" IsEnabled="False" Toggled="Preference_Toggled" Tag="automaticUpdates" OffContent="" OnContent=""/>
        </Grid>
        <TextBlock x:Name="UpdateStatus" Text="Conectando ao atualizador local…" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
        <Button x:Name="CheckUpdatesButton" Content="VERIFICAR AGORA" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" HorizontalAlignment="Left" Click="CheckUpdates_Click"/>
      </StackPanel>
      
      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"/>
      
      <!-- Sobre -->
      <StackPanel Padding="0,18" Spacing="6">
        <TextBlock Text="SOBRE O PRODUTO" Style="{StaticResource EyebrowTextStyle}"/>
        <TextBlock Text="LagCheck para Windows — Launcher gamer com pre-flight check de rede integrado. Sem conta obrigatória e sem anúncios." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="14"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
