<Page x:Class="LagCheck.WinUI.Pages.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="620">
    <TextBlock Text="Ajustes" Style="{StaticResource PageTitleStyle}"/>
    <TextBlock Text="Controle como o protótipo se comporta neste PC." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,6"/>
    <TextBlock x:Name="ConnectionStatus" Text="Conectando aos ajustes locais…" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,20"/>
    <Grid Padding="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Reduzir movimento" FontWeight="SemiBold"/><TextBlock Text="Para transições e animações da interface." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><ToggleSwitch x:Name="ReduceMotionSwitch" Grid.Column="1" IsEnabled="False" Toggled="Preference_Toggled" Tag="reduceMotion" OffContent="" OnContent=""/></Grid>
    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"/>
    <Grid Padding="0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Baixar imagens dos jogos" FontWeight="SemiBold"/><TextBlock Text="Capas e banners permitidos, guardados neste PC. Desligado, usa só o que já está no PC." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><ToggleSwitch x:Name="ArtworkSwitch" Grid.Column="1" IsEnabled="False" Toggled="Preference_Toggled" Tag="artworkDownload" OffContent="" OnContent=""/></Grid>
    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"/>
    <Grid Padding="0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Localização aproximada" FontWeight="SemiBold"/><TextBlock Text="Cidade aproximada pelo IP, só para posicionar o mapa. Nunca GPS." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><ToggleSwitch x:Name="ApproximateLocationSwitch" Grid.Column="1" IsEnabled="False" Toggled="Preference_Toggled" Tag="approximateLocation" OffContent="" OnContent=""/></Grid>
    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"/>
    <StackPanel Padding="0,18" Spacing="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Enviar dados de uso anônimos" FontWeight="SemiBold"/><TextBlock Text="Jogo, resultado e duração. Sem IP, rede, local ou nome." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><ToggleSwitch x:Name="AnalyticsSwitch" Grid.Column="1" IsEnabled="False" Toggled="Preference_Toggled" Tag="analytics" OffContent="" OnContent=""/></Grid><Button x:Name="RenewAnalyticsIdButton" Content="GERAR NOVO ID" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" HorizontalAlignment="Left" Click="RenewAnalyticsId_Click"/><TextBlock x:Name="AnalyticsStatus" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"/>
    <StackPanel Padding="0,18" Spacing="8"><TextBlock Text="ATUALIZAÇÕES" Style="{StaticResource EyebrowTextStyle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Verificar automaticamente" FontWeight="SemiBold"/><TextBlock Text="Usa somente a fonte segura configurada para este protótipo." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><ToggleSwitch x:Name="AutomaticUpdatesSwitch" Grid.Column="1" IsEnabled="False" Toggled="Preference_Toggled" Tag="automaticUpdates" OffContent="" OnContent=""/></Grid><TextBlock x:Name="UpdateStatus" Text="Conectando ao atualizador local…" Foreground="{StaticResource TextSecondaryBrush}"/><Button x:Name="CheckUpdatesButton" Content="VERIFICAR AGORA" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" HorizontalAlignment="Left" Click="CheckUpdates_Click"/></StackPanel>
    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"/>
    <StackPanel Padding="0,18" Spacing="8"><TextBlock Text="SOBRE" Style="{StaticResource EyebrowTextStyle}"/><TextBlock Text="Protótipo interno do LagCheck para Windows. Sem conta e sem anúncio." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
  </StackPanel></ScrollViewer>
</Page>
