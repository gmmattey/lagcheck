<Page x:Class="LagCheck.WinUI.Pages.HistoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowSpacing="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Histórico" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Resultados concluídos ficam neste PC." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/></StackPanel>
    <TextBox x:Name="SearchBox" Grid.Row="1" PlaceholderText="Buscar por região ou veredito" TextChanged="SearchBox_TextChanged" />
    <Grid Grid.Row="2"><ListView x:Name="HistoryList" SelectionMode="None" Visibility="Collapsed"><ListView.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Verdict}" FontFamily="{StaticResource HeadingFont}" FontWeight="Bold"/><TextBlock Text="{Binding RegionLabel}" Style="{StaticResource EyebrowTextStyle}" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding PingLabel}" FontFamily="{StaticResource MetricFont}" HorizontalAlignment="Right"/><TextBlock Grid.Column="2" Text="{Binding JitterLabel}" FontFamily="{StaticResource MetricFont}" HorizontalAlignment="Right"/><TextBlock Grid.Column="3" Text="{Binding LossLabel}" FontFamily="{StaticResource MetricFont}" HorizontalAlignment="Right"/><TextBlock Grid.Column="4" Text="{Binding TimeLabel}" Style="{StaticResource EyebrowTextStyle}" HorizontalAlignment="Right"/></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView><StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" Spacing="10"><TextBlock Text="Sem testes nesta sessão" Style="{StaticResource PageTitleStyle}" TextAlignment="Center" /><TextBlock Text="Quando uma medição terminar pelo motor compartilhado, o resultado real aparece aqui." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center"/></StackPanel><TextBlock x:Name="NoResults" Text="Nenhuma medição corresponde à busca." Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Grid>
  </Grid>
</Page>
