<Page x:Class="LagCheck.WinUI.ShellPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:automation="using:Microsoft.UI.Xaml.Automation">
  <Grid Background="{StaticResource DeepBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid Grid.Column="0" Background="{StaticResource StageBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
      <Grid.RowDefinitions><RowDefinition Height="104"/><RowDefinition Height="*"/><RowDefinition Height="108"/></Grid.RowDefinitions>
      <StackPanel Padding="24,28,20,0">
        <Image Source="ms-appx:///Assets/wordmark-primary.svg" Height="20" HorizontalAlignment="Left" automation:AutomationProperties.Name="LagCheck" />
        <TextBlock Text="WINDOWS" Style="{StaticResource EyebrowTextStyle}" Margin="0,8,0,0" />
      </StackPanel>
      <StackPanel Grid.Row="1" Padding="0,18,0,0">
        <Button x:Name="LibraryButton" Style="{StaticResource NavButtonStyle}" Click="Library_Click"><StackPanel Orientation="Horizontal"><SymbolIcon Symbol="Home" Margin="0,0,9,0"/><TextBlock Text="Biblioteca"/></StackPanel></Button>
        <Button x:Name="CatalogButton" Style="{StaticResource NavButtonStyle}" Click="Catalog_Click"><StackPanel Orientation="Horizontal"><SymbolIcon Symbol="AllApps" Margin="0,0,9,0"/><TextBlock Text="Catálogo"/></StackPanel></Button>
        <Button x:Name="HistoryButton" Style="{StaticResource NavButtonStyle}" Click="History_Click"><StackPanel Orientation="Horizontal"><SymbolIcon Symbol="Clock" Margin="0,0,9,0"/><TextBlock Text="Histórico"/></StackPanel></Button>
        <Button x:Name="SettingsButton" Style="{StaticResource NavButtonStyle}" Click="Settings_Click"><StackPanel Orientation="Horizontal"><SymbolIcon Symbol="Setting" Margin="0,0,9,0"/><TextBlock Text="Ajustes"/></StackPanel></Button>
      </StackPanel>
      <StackPanel Grid.Row="2" Padding="16,14" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
        <TextBlock Text="ANTES DE ENTRAR NA FILA." FontFamily="{StaticResource HeadingFont}" FontWeight="Bold" FontSize="14"/>
        <TextBlock Text="Um check. Uma decisão mais clara." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Background="{StaticResource DeepBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="38,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal"><TextBlock Text="LAGCHECK" Style="{StaticResource EyebrowTextStyle}" Foreground="{StaticResource PurpleLightBrush}"/><TextBlock Text="  /  " Style="{StaticResource EyebrowTextStyle}"/><TextBlock x:Name="RouteText" Style="{StaticResource EyebrowTextStyle}" Foreground="{StaticResource TextPrimaryBrush}"/></StackPanel>
        <TextBlock Grid.Column="1" Text="PRÉVIA WINDOWS" Style="{StaticResource EyebrowTextStyle}" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
      <Frame x:Name="ContentFrame" Grid.Row="1" Padding="38,32" />
    </Grid>
  </Grid>
</Page>
