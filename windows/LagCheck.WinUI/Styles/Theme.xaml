<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="StageColor">#060709</Color><Color x:Key="DeepColor">#0B0D10</Color><Color x:Key="SurfaceColor">#15181E</Color><Color x:Key="PanelColor">#1E232B</Color><Color x:Key="LineColor">#1AF4F5F7</Color><Color x:Key="LineStrongColor">#29F4F5F7</Color><Color x:Key="TextPrimaryColor">#F4F5F7</Color><Color x:Key="TextSecondaryColor">#8A93A0</Color><Color x:Key="TextTertiaryColor">#606873</Color><Color x:Key="PurpleColor">#7C3AED</Color><Color x:Key="PurpleLightColor">#A78BFA</Color><Color x:Key="CoralColor">#FF5A36</Color>
  <SolidColorBrush x:Key="StageBrush" Color="{StaticResource StageColor}"/><SolidColorBrush x:Key="DeepBrush" Color="{StaticResource DeepColor}"/><SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/><SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/><SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}"/><SolidColorBrush x:Key="LineStrongBrush" Color="{StaticResource LineStrongColor}"/><SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/><SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/><SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/><SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleColor}"/><SolidColorBrush x:Key="PurpleLightBrush" Color="{StaticResource PurpleLightColor}"/><SolidColorBrush x:Key="CoralBrush" Color="{StaticResource CoralColor}"/>
  <SolidColorBrush x:Key="ToggleSwitchTrackOnFill" Color="{StaticResource PurpleColor}"/><SolidColorBrush x:Key="ToggleSwitchTrackOnStroke" Color="{StaticResource PurpleLightColor}"/><SolidColorBrush x:Key="ToggleSwitchTrackOnFillPointerOver" Color="#8B5CF6"/><SolidColorBrush x:Key="ToggleSwitchTrackOnFillPressed" Color="#6D28D9"/><SolidColorBrush x:Key="ToggleSwitchThumbOnFill" Color="{StaticResource TextPrimaryColor}"/><SolidColorBrush x:Key="ToggleSwitchTrackOffFill" Color="{StaticResource PanelColor}"/><SolidColorBrush x:Key="ToggleSwitchTrackOffStroke" Color="{StaticResource LineStrongColor}"/><SolidColorBrush x:Key="ToggleSwitchThumbOffFill" Color="{StaticResource TextSecondaryColor}"/><SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="{StaticResource PurpleLightColor}"/><SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="{StaticResource DeepColor}"/>
  <FontFamily x:Key="BodyFont">ms-appx:///Assets/Fonts/barlow_regular.ttf#Barlow</FontFamily><FontFamily x:Key="HeadingFont">ms-appx:///Assets/Fonts/barlow_semicondensed_bold.ttf#Barlow Semi Condensed</FontFamily><FontFamily x:Key="MetricFont">ms-appx:///Assets/Fonts/chakra_petch_semibold.ttf#Chakra Petch</FontFamily><FontFamily x:Key="TechnicalFont">Cascadia Mono</FontFamily>
  <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource BodyFont}"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/></Style>
  <Style x:Key="EyebrowTextStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource TechnicalFont}"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="CharacterSpacing" Value="120"/><Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/></Style>
  <Style x:Key="PageTitleStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource HeadingFont}"/><Setter Property="FontSize" Value="30"/><Setter Property="FontWeight" Value="ExtraBold"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/></Style>
  <Style x:Key="NavButtonStyle" TargetType="Button"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,2"/><Setter Property="FontFamily" Value="{StaticResource BodyFont}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="CornerRadius" Value="8"/></Style>
  <Style x:Key="PrimaryButtonStyle" TargetType="Button"><Setter Property="MinHeight" Value="48"/><Setter Property="Padding" Value="20,0"/><Setter Property="FontFamily" Value="{StaticResource BodyFont}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Background" Value="{StaticResource PurpleBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource PurpleBrush}"/><Setter Property="CornerRadius" Value="12"/></Style>
  <Style x:Key="SecondaryButtonStyle" TargetType="Button"><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="16,0"/><Setter Property="FontFamily" Value="{StaticResource BodyFont}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/></Style>
  <Style TargetType="TextBox"><Setter Property="MinHeight" Value="44"/><Setter Property="FontFamily" Value="{StaticResource BodyFont}"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}"/><Setter Property="CornerRadius" Value="8"/></Style>
</ResourceDictionary>
