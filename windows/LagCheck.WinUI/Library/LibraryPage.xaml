<Page
    x:Class="LagCheck.WinUI.Library.LibraryPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LagCheck.WinUI.Library"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    Background="{StaticResource DeepBrush}"
    Loaded="LibraryPage_Loaded">

    <Page.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24" Padding="38,32,38,48">
            <!-- Cabeçalho da Biblioteca (windows/DESIGN.md § 2 e § 6) -->
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock Text="BIBLIOTECA DE JOGOS" Foreground="{StaticResource PurpleLightBrush}" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Text="Sua próxima partida começa aqui." Style="{StaticResource PageTitleStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="Escolha o jogo e confira a conexão antes de entrar na fila." Foreground="{StaticResource TextSecondaryBrush}" FontSize="15" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="ATUALIZAR BIBLIOTECA" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding RefreshCommand}" automation:AutomationProperties.Name="Atualizar biblioteca de jogos" />
            </Grid>

            <!-- Notificações e Status de Varredura -->
            <TextBlock x:Name="NoticeText" Text="{Binding Notice}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
            <TextBlock x:Name="LoadingState" Text="PROCURANDO JOGOS INSTALADOS…" Foreground="{StaticResource PurpleLightBrush}" Style="{StaticResource EyebrowTextStyle}" Visibility="Collapsed" />

            <!-- Hero do Jogo Selecionado (windows/DESIGN.md § 7.1) -->
            <Border x:Name="HeroSection" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" MinHeight="250">
                <ContentControl Content="{Binding HeroGame}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="local:LibraryGame">
                            <Grid>
                                <!-- Banner oficial e camadas de contraste -->
                                <Image Source="{Binding HeroArtworkPath}" Stretch="UniformToFill" Opacity="0.52" />
                                <Rectangle Fill="#C8060709" />
                                <Rectangle Fill="#1A7C3AED" />
                                
                                <Grid Padding="32,28" VerticalAlignment="Stretch">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Badges Superiores -->
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="EM DESTAQUE" Foreground="{StaticResource PurpleLightBrush}" Style="{StaticResource EyebrowTextStyle}" />
                                        <TextBlock Text="·" Foreground="{StaticResource TextTertiaryBrush}" Style="{StaticResource EyebrowTextStyle}" />
                                        <TextBlock Text="{Binding PlatformLabel}" Foreground="{StaticResource TextSecondaryBrush}" Style="{StaticResource EyebrowTextStyle}" />
                                        <TextBlock Text="·" Foreground="{StaticResource TextTertiaryBrush}" Style="{StaticResource EyebrowTextStyle}" />
                                        <TextBlock Text="{Binding DiagnosticLabel}" Foreground="{StaticResource ReadyBrush}" Style="{StaticResource EyebrowTextStyle}" />
                                    </StackPanel>
                                    
                                    <!-- Identificação do Título -->
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="8" Margin="0,14,0,18">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource HeroTitleStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding NetworkLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="15" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding AvailabilityLabel}" Foreground="{StaticResource TextTertiaryBrush}" Style="{StaticResource EyebrowTextStyle}" />
                                    </StackPanel>
                                    
                                    <!-- Ações do Hero: Jogar prioritário + Checar Conexão (DESIGN.md § 7.1) -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
                                        <Button Content="JOGAR" Style="{StaticResource PrimaryButtonStyle}" MinHeight="50" Padding="32,0"
                                                Command="{Binding DataContext.LaunchCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                automation:AutomationProperties.Name="Jogar agora" />
                                        <Button Content="CHECAR CONEXÃO" Style="{StaticResource SecondaryButtonStyle}"
                                                Visibility="{Binding CanTestConnection, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Command="{Binding DataContext.TestConnectionCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                automation:AutomationProperties.Name="Checar conexão deste jogo" />
                                        <Button Content="{Binding FavoriteActionLabel}" Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding DataContext.ToggleFavoriteCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                automation:AutomationProperties.Name="Alternar favorito" />
                                        <Button Content="ATUALIZAR IMAGEM" Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding DataContext.RefreshArtworkCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                automation:AutomationProperties.Name="Atualizar imagem do jogo" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Border>

            <!-- Barra de Controles: Busca e Chips de Filtro (windows/DESIGN.md § 7.2) -->
            <StackPanel x:Name="LibraryControls" Spacing="14">
                <TextBlock Text="ENCONTRE SUA PARTIDA" Foreground="{StaticResource PurpleLightBrush}" Style="{StaticResource EyebrowTextStyle}" />
                <TextBox x:Name="SearchBox" PlaceholderText="Buscar na biblioteca (Ctrl+F)" TextChanged="SearchBox_TextChanged"
                         automation:AutomationProperties.Name="Buscar na biblioteca" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="TODOS" Style="{StaticResource ChipButtonStyle}" Command="{Binding SelectFilterCommand}" CommandParameter="All" />
                        <Button Content="INSTALADOS" Style="{StaticResource ChipButtonStyle}" Command="{Binding SelectFilterCommand}" CommandParameter="Installed" />
                        <Button Content="STEAM" Style="{StaticResource ChipButtonStyle}" Command="{Binding SelectFilterCommand}" CommandParameter="Steam" />
                        <Button Content="EPIC GAMES" Style="{StaticResource ChipButtonStyle}" Command="{Binding SelectFilterCommand}" CommandParameter="Epic" />
                        <Button Content="XBOX" Style="{StaticResource ChipButtonStyle}" Command="{Binding SelectFilterCommand}" CommandParameter="Xbox" />
                        <Button Content="FAVORITOS" Style="{StaticResource ChipButtonStyle}" Command="{Binding SelectFilterCommand}" CommandParameter="Favorites" />
                        <Button Content="RECENTES" Style="{StaticResource ChipButtonStyle}" Command="{Binding SelectFilterCommand}" CommandParameter="Recent" />
                        <TextBlock Text="{Binding GameCountLabel}" Foreground="{StaticResource TextSecondaryBrush}" Style="{StaticResource EyebrowTextStyle}" VerticalAlignment="Center" Margin="14,0,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>

            <!-- Estados Vazios -->
            <Border x:Name="EmptyState" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="32" Visibility="Collapsed">
                <StackPanel Spacing="10" MaxWidth="580">
                    <TextBlock Text="Nenhum jogo instalado apareceu ainda." Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Abra a Steam, Epic Games ou Xbox e atualize a biblioteca. Seus favoritos e jogos conhecidos continuam guardados mesmo se um launcher estiver indisponível." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <Button Content="PROCURAR JOGOS" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Command="{Binding RefreshCommand}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border x:Name="NoResults" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="28" Visibility="Collapsed">
                <TextBlock Text="Nenhum jogo corresponde à busca ou ao filtro atual." Foreground="{StaticResource TextSecondaryBrush}" />
            </Border>

            <!-- Grade da Biblioteca: Capas Verticais 2:3 Padronizadas (DESIGN.md § 7.2) -->
            <ItemsRepeater x:Name="GameGrid" ItemsSource="{Binding VisibleGames}" ElementPrepared="GameGrid_ElementPrepared">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="190" MinRowSpacing="16" MinColumnSpacing="16" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:LibraryGame">
                        <Button Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="0"
                                Command="{Binding DataContext.SelectGameCommand, ElementName=Root}" CommandParameter="{Binding}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                automation:AutomationProperties.Name="{Binding Title}">
                            <!-- Proporção 2:3 vertical padronizada (ex: 190x285 px) -->
                            <Grid Height="285">
                                <Image Source="{Binding CoverArtworkPath}" Stretch="UniformToFill" Opacity="0.90" />
                                <Grid VerticalAlignment="Bottom" Padding="14,12" Background="#E615181E" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource HeadingFont}" FontWeight="Bold" FontSize="18" TextWrapping="Wrap" MaxLines="2" />
                                    <TextBlock Grid.Row="1" Text="{Binding AvailabilityLabel}" Foreground="{StaticResource TextSecondaryBrush}" Style="{StaticResource EyebrowTextStyle}" Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="2" Text="{Binding DiagnosticLabel}" Foreground="{StaticResource PurpleLightBrush}" Style="{StaticResource EyebrowTextStyle}" Margin="0,3,0,0" />
                                </Grid>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
