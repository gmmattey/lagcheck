{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nolaggy-deep-check",
  "main": "src/index.js",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "assets": {
    "directory": "./catalog/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "cache": {
    "enabled": false
  },
  "kv_namespaces": [
    {
      "binding": "WAITLIST_KV",
      "id": "e1cd0a74d6a44078a57330b4fc06b71e"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": [
      "0 12 * * *"
    ]
  }
}
