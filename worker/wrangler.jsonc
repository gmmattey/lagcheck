{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nolaggy-deep-check",
  "main": "src/index.js",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "assets": {
    "directory": "./catalog/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "cache": {
    "enabled": false
  }
}
