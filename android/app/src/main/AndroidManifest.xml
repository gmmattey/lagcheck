<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Conexão para probes UDP e Worker Cloudflare -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Anúncios (Decisão 82): ID de publicidade para o AdMob; só usado com ADS_ENABLED e consentimento. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <!-- Telemetria física de rádio sem rastreamento de localização (Android 13+) -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

    <!-- Só Android 12 ou menor: lá o Wi-Fi (frequência/RSSI) exige localização. Do Android 13 em diante vale NEARBY_WIFI_DEVICES
         com neverForLocation, e o app nem declara localização. Negar é seguro: a medição UDP segue normalmente. -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />

    <!-- Visibilidade dos apps das redes para compartilhar direto no app (Decisão 81). -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="org.telegram.messenger" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.twitter.android" />
        <package android:name="com.instagram.android" />
    </queries>

    <application
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="LagCheck"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <!-- Mesmas rotas públicas do App Clip/iOS. O app abre a Home e
                 nunca inicia uma medição apenas por dados da URL. A
                 verificação depende do assetlinks.json assinado com o
                 certificado de produção da Play Console. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="lagcheck.signallq.com"
                    android:pathPrefix="/check" />
                <data
                    android:scheme="https"
                    android:host="lagcheck.signallq.com"
                    android:pathPrefix="/quicktest" />
            </intent-filter>
        </activity>

        <!-- Ícone do app (Decisão 83): um alias por ícone; só um fica habilitado. O Clássico é o padrão. -->
        <activity-alias
            android:name=".icon.ClassicIcon"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="LagCheck"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.ThumbsIcon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_thumbs"
            android:roundIcon="@mipmap/ic_launcher_thumbs"
            android:label="LagCheck"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.WinkIcon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_wink"
            android:roundIcon="@mipmap/ic_launcher_wink"
            android:label="LagCheck"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".icon.CheerIcon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cheer"
            android:roundIcon="@mipmap/ic_launcher_cheer"
            android:label="LagCheck"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
